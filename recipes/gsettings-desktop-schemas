#! /bin/sh

name=gsettings-desktop-schemas
version=50.1
revision=1
tarball_url="https://gitlab.gnome.org/GNOME/gsettings-desktop-schemas/-/archive/${version}/gsettings-desktop-schemas-${version}.tar.gz"
tarball_blake2b="d2b9d6c857a33f9c2725131711969d6f3bc86a69264a28e33f4294eac0a6f25dec25807799fcb99a598e397aed1e747de3369e9bab9625490ae73e220d71e0db"
imagedeps="libglib2.0-dev"
hostdeps="gcc pkg-config"
deps="core-libs glib2"

prepare() {
    sed -i -r 's:"(/system):"/org/gnome\1:g' schemas/*.in
}

configure() {
    meson_configure \
        -Dintrospection=false
}

build() {
    meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    glib-compile-schemas "${dest_dir}${prefix}"/share/glib-2.0/schemas
    rm "${dest_dir}${prefix}"/share/glib-2.0/schemas/gschemas.compiled

    post_package_strip
    generate_glib_schemas_hook
}
