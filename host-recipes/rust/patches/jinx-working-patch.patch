index 0000000..6eb0d98
--- /dev/null
+++ rust-workdir/compiler/rustc_target/src/spec/base/ironclad_gnu.rs
@@ -0,0 +1,22 @@
+use crate::spec::{Env, Os, RelroLevel, TargetOptions, cvs};
+
+pub(crate) fn opts() -> TargetOptions {
+    TargetOptions {
+        os: Os::Ironclad,
+        // Ironclad's C library is glibc, so the environment is the same one
+        // x86_64-unknown-linux-gnu uses and the target tuple ends in -gnu.
+        env: Env::Gnu,
+        dynamic_linking: true,
+        families: cvs!["unix"],
+        has_rpath: true,
+        position_independent_executables: true,
+        relro_level: RelroLevel::Full,
+        has_thread_local: true,
+        crt_static_respected: true,
+        // Our glibc implements backtrace(), which is what epoch's crash handler
+        // and zstd's BACKTRACE_ENABLE rely on, so unwind tables are wanted by
+        // default here for the same reason they are on linux.
+        default_uwtable: true,
+        ..Default::default()
+    }
+}
