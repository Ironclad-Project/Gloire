# rustix's cfg lists name the platforms that LACK a given Linux constant, and hurd
# is on them where we are not. Guarded here are the 42 our glibc genuinely does not
# define; the 31 it does are declared in the libc crate's ironclad module instead.
#
# rust-patch-versions: 1.*
#
# The one positive list joined is `_Opcode`: our sys/ioctl.h declares
# `int ioctl (int, unsigned long int, ...)`, so c_ulong is correct.
--- a/src/backend/libc/fs/syscalls.rs	2006-07-24 03:21:28.000000000 +0200
+++ b/src/backend/libc/fs/syscalls.rs	2026-09-03 10:14:22.066216020 +0200
@@ -150,6 +150,7 @@
         unix,
         target_env = "gnu",
         not(target_os = "hurd"),
+        not(target_os = "ironclad"),
         not(target_os = "freebsd")
     ))]
     if oflags.contains(OFlags::TMPFILE) && crate::backend::if_glibc_is_less_than_2_25() {
@@ -218,6 +219,7 @@
         unix,
         target_env = "gnu",
         not(target_os = "hurd"),
