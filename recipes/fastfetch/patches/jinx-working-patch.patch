diff --git fastfetch-workdir/src/detection/processes/processes_ironclad.c fastfetch-workdir/src/detection/processes/processes_ironclad.c
new file mode 100644
index 0000000..9b1d0db
--- /dev/null
+++ fastfetch-workdir/src/detection/processes/processes_ironclad.c
@@ -0,0 +1,30 @@
+
+#include "processes.h"
+
+#include <stdlib.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+// SYS_listprocs reports how many processes exist even when the buffer is too small,
+// which is exactly the count wanted here -- so unlike util-ironclad's ps.c there is
+// no need to grow the buffer and call twice.
+struct ironclad_procinfo {
+    char     id[20];
+    uint16_t id_len;
+    uint16_t ppid;
+    uint16_t pid;
+    uint32_t uid;
+    uint32_t flags;
+    struct timespec elapsed;
+} __attribute__((packed));
+
+const char* ffDetectProcesses(uint32_t* result) {
+    struct ironclad_procinfo probe;
+    long ret = syscall(SYS_listprocs, &probe, 1);
+
+    if (ret < 0)
+        return "syscall(SYS_listprocs) failed";
+
+    *result = (uint32_t) ret;
+    return NULL;
+}
diff --git fastfetch-workdir/src/detection/swap/swap_ironclad.c fastfetch-workdir/src/detection/swap/swap_ironclad.c
new file mode 100644
index 0000000..19aa13a
--- /dev/null
+++ fastfetch-workdir/src/detection/swap/swap_ironclad.c
@@ -0,0 +1,11 @@
+
+#include "swap.h"
+
+// Ironclad has no swap at all -- no swap device, no swap file, no interface to
+// enumerate one. An EMPTY LIST is therefore the accurate answer and is a different
+// statement from "Not supported on this platform": there is nothing to report, not
+// something we cannot read.
+const char* ffDetectSwap(FFlist* swap) {
+    (void) swap;
+    return NULL;
+}
