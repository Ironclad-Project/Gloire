#! /bin/sh

version=3.13.1
revision=2
tarball_url="https://feh.finalrewind.org/feh-${version}.tar.bz2"
tarball_blake2b="35b8b095d26590d3153c5d060bc78df406eb9ddbf0e551554fd0afc5485fac5a817472a183663f708e5b5406a10b4c3e9d8e679afd1889dac56c0a7655eaf055"
hostdeps="gcc pkg-config"
deps="core-libs curl file hicolor-icon-theme imlib2 libexif libpng libx11 libxinerama"
builddeps="libxt"

build() {
    cp -rp "${source_dir}"/. ./

        CC=${OS_TRIPLET}-gcc \
        CFLAGS="${TARGET_CFLAGS}" \
        LDFLAGS="${TARGET_LDFLAGS}" \
    make PREFIX="${prefix}" -j${parallelism} \
        exif=1 \
        help=1 \
        magic=1 \
        stat64=1
}

package() {
    DESTDIR="${dest_dir}" PREFIX="${prefix}" make install

    post_package_strip
}
