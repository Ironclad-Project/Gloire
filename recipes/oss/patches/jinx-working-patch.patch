+/*
+ * GTK3 dropped gtk_widget_modify_bg()/gtk_widget_modify_fg(): widget colours
+ * come from CSS now.  Attach a widget local provider so the rgbcolor the
+ * driver reports still has an effect.
+ */
+static void
+set_widget_color (GtkWidget * wid, unsigned int rgbcolor, gboolean foreground)
+{
+  GtkCssProvider *provider;
+  const char *node = "*";
+  char css[224];
+
+#if GTK_CHECK_VERSION(3,20,0)
+  /*
+   * Scope the rule to the widget's own CSS node.  A "*" rule also matches the
+   * theme's sub-nodes (a scale's trough and slider, a combo box's button), so
+   * it paints over the whole control instead of tinting it the way
+   * gtk_widget_modify_bg() did.
+   */
+  node = gtk_widget_class_get_css_name (GTK_WIDGET_GET_CLASS (wid));
+  if ((node == NULL) || (*node == '\0'))
+    node = "*";
 #endif
+
+  if (foreground)
+    snprintf (css, sizeof (css), "%s { color: #%06x; }", node,
+	      rgbcolor & 0xffffff);
+  else
+    snprintf (css, sizeof (css),
+	      "%s { background-image: none; background-color: #%06x; }",
+	      node, rgbcolor & 0xffffff);
+
+  provider = gtk_css_provider_new ();
+  if (gtk_css_provider_load_from_data (provider, css, -1, NULL))
+    gtk_style_context_add_provider (gtk_widget_get_style_context (wid),
+				    GTK_STYLE_PROVIDER (provider),
+				    GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
+  g_object_unref (provider);
+}
+
+/*
