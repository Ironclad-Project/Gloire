#! /bin/sh

name=libxml2
version=2.15.2
revision=1
tarball_url="https://gitlab.gnome.org/GNOME/libxml2/-/archive/v${version}/libxml2-v${version}.tar.gz"
tarball_blake2b="85f775895d78db918a3f85451f73b95887207a8d4552dea54c4fd7b9f8bc171f389f11e8ee874f509e690a4873d86777db7d731ba59b7dc31a2aa3e2caa104c3"
hostdeps="gcc pkg-config"
deps="core-libs icu readline zlib"

configure() {
    meson_configure \
        -Dpython=disabled \
        -Dhistory=enabled \
        -Dicu=enabled \
        -Dreadline=enabled \
        -Dzlib=enabled
}

build() {
    meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
