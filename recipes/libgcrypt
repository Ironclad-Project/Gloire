#! /bin/sh

name=libgcrypt
version=1.12.1
revision=1
tarball_url="https://www.gnupg.org/ftp/gcrypt/libgcrypt/libgcrypt-${version}.tar.gz"
tarball_blake2b="376c940c6c9860f9b0318e37fe39eb33d3991ade768a1080808e71678ab4f90d9526290d26d78c203eb622336ad814fb2fb7525f02944092b60a23245305ab84"
imagedeps="build-essential libgpg-error-dev"
hostdeps="gcc pkg-config"
deps="core-libs libgpg-error"

prepare() {
    autotools_recursive_regen
}

configure() {
    autotools_configure \
        --with-libgpg-error-prefix="${sysroot_dir}${prefix}"
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    post_package_strip
}
