#! /bin/sh

version=2.62.1
revision=2
tarball_url="https://download.gnome.org/sources/at-spi2-core/2.62/at-spi2-core-${version}.tar.xz"
tarball_blake2b="abf3eb9265efe8e893e8badf4e66c21a072ed0e7b0991e14fcf7a980796f1e0eb2139ae88ab53a14b39257e5d14efe92eada9eceffd42eea03c0a6c9001b9ad0"
imagedeps="libglib2.0-dev-bin"
hostdeps="gcc pkg-config"
deps="core-libs dbus glib2 gsettings-desktop-schemas libx11 libxi libxtst"
builddeps="libxml2"

configure() {
    meson_configure \
        -Dpython.platlibdir="${prefix}/lib/python3/site-packages" \
        -Dpython.purelibdir="${prefix}/lib/python3/site-packages" \
        -Ddefault_bus=dbus-daemon \
        -Duse_systemd=false \
        -Dgtk2_atk_adaptor=false \
        -Dintrospection=disabled
}

build() {
    meson compile --verbose -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
