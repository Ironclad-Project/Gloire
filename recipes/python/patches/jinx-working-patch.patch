diff --git python-clean/Makefile.pre.in python-workdir/Makefile.pre.in
index 526d500..63875c3 100644
--- python-clean/Makefile.pre.in
+++ python-workdir/Makefile.pre.in
@@ -175,8 +175,8 @@ CONFINCLUDEPY=	$(CONFINCLUDEDIR)/python$(LDVERSION)
