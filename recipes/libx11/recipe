#! /bin/sh

version=1.8.14
revision=1
tarball_url="https://www.x.org/archive/individual/lib/libX11-${version}.tar.xz"
tarball_blake2b="0bb56f393ebaf12f62d145f543bc192055879e9d6a7d50d2d141c446dabb8756e3347d260dedb26014d7604fa22b196d9321dbd3f5bf4888a295057e8ef0624d"
imagedeps="build-essential"
hostdeps="gcc pkg-config"
deps="core-libs xorg-proto libxcb xtrans"

prepare() {
    autotools_recursive_regen
}

configure() {
    autotools_configure \
        --with-keysymdefdir=${sysroot}${prefix}/include/X11 \
        --disable-xf86bigfont
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    post_package_strip
}
