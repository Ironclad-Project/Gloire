#!/bin/sh

# Gloire builds with the commit of Jinx pinned below, which this script fetches
# on first use and then runs in its stead.

set -e

jinx_commit=3542778ff0c772285b3348b06039927c71b0c110
jinx_sha256=42d07c542d048e64e41472cc5892825e0f008c516781413cef734f6f66c66ccf

source_dir="$(cd "$(dirname "$0")" && pwd -P)"
jinx_dir="${source_dir}/.jinx-fetched"
jinx="${jinx_dir}/jinx"

if ! sha256sum "${jinx}" 2>/dev/null | grep -q "^${jinx_sha256} "; then
    # Whatever root fetched here, the user who builds could not replace later.
    if [ "$(id -u)" = 0 ]; then
        echo "error: Jinx needs fetching, which must not happen as root; run any jinx command as the user who builds first." 1>&2
        exit 1
    fi

    mkdir -p "${jinx_dir}"
    tmp="$(mktemp "${jinx_dir}/jinx.XXXXXXXX")"
    trap 'rm -f "${tmp}"' EXIT
    if ! wget -q -O "${tmp}" "https://raw.githubusercontent.com/Mintsuki/Jinx/${jinx_commit}/jinx"; then
        echo "error: Could not fetch Jinx at commit ${jinx_commit}." 1>&2
        exit 1
    fi
    if ! sha256sum "${tmp}" | grep -q "^${jinx_sha256} "; then
        echo "error: The Jinx fetched does not match the SHA256 pinned for it." 1>&2
        exit 1
    fi
    chmod 0755 "${tmp}"
    mv "${tmp}" "${jinx}"
    trap - EXIT
fi

exec "${jinx}" "$@"
