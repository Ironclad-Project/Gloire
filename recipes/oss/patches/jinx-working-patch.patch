+};
diff --git oss-workdir/setup/Ironclad/gen-oss-errno.sh oss-workdir/setup/Ironclad/gen-oss-errno.sh
new file mode 100755
index 0000000..7e82ef9
--- /dev/null
+++ oss-workdir/setup/Ironclad/gen-oss-errno.sh
@@ -0,0 +1,70 @@
+#!/bin/sh
+#
+# Generate kernel/framework/include/oss_errno.h for the Ironclad port.
+#
+# srcconf.c (produce_errno_h) does this by compiling and running a program on
+# the build host, which is wrong when cross compiling: the numbers have to
+# come from the *target* <errno.h>.  Expanding the macros with the target
+# preprocessor gives the same result without running anything.
+#
+# Usage: gen-oss-errno.sh "<cc> [cppflags...]" > oss_errno.h
+#
+set -e
+
+CC="$1"
+[ -n "${CC}" ] || { echo "usage: $0 \"<cc> [cppflags...]\"" >&2; exit 1; }
+
+ERRNOS="E2BIG EACCES EAGAIN EBADE EBUSY ECONNRESET EDOM EFAULT EIDRM EINTR \
+	EINVAL EIO ELOOP ENODEV ENOENT ENOMEM ENOSPC ENOTSUP ENXIO EPERM \
+	EPIPE ERANGE EWOULDBLOCK"
+
+cat <<'EOF'
+#ifndef OSS_ERRNO_H
+#define OSS_ERRNO_H
+
+/*
+ * Error (errno) codes used by OSS.
+ *
+ * This file is automatically generated by setup/Ironclad/gen-oss-errno.sh -
+ * do not edit.
+ *
+ * The following codes are derived from the system dependent
+ * error numbers defined in <errno.h>
+ */
+
+EOF
+
+{
+	echo '#include <errno.h>'
+	# Codes that are not universal.  Same fallbacks srcconf.c uses.
+	echo '#ifndef EBADE'
+	echo '#define EBADE EINVAL'
+	echo '#endif'
+	echo '#ifndef EIDRM'
+	echo '#define EIDRM EFAULT'
+	echo '#endif'
+	echo '#ifndef ENOTSUP'
+	echo '#define ENOTSUP ENOSYS'
+	echo '#endif'
+	echo '#ifndef EFAULT'
+	echo '#define EFAULT ENOTSUP'
+	echo '#endif'
+	# String literals are not macro expanded, so the name survives and the
+	# value next to it gets substituted by the target preprocessor.
+	for e in ${ERRNOS}; do
+		echo "@OSSERR@ \"${e}\" ${e}"
+	done
+} | ${CC} -E -P -xc - | awk '
+	/^@OSSERR@/ {
+		name = $2
+		gsub(/"/, "", name)
+		val = $3 + 0
+		if (val > 0)
+			val = -val
+		printf "#define OSS_%s\t\t%du\n", name, val
+	}'
+
+cat <<'EOF'
+
+#endif
+EOF
