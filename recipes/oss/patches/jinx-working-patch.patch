+static void
+combo_set_active_text (GtkComboBox * combo, const char * text)
+{
+  GtkTreeModel *model;
+  GtkTreeIter iter;
+  gboolean ok;
+  int i = 0;
+
+  if ((text == NULL) || ((model = gtk_combo_box_get_model (combo)) == NULL))
+    return;
+
+  for (ok = gtk_tree_model_get_iter_first (model, &iter); ok;
+       ok = gtk_tree_model_iter_next (model, &iter), i++)
+    {
+      char *s = NULL;
+
+      gtk_tree_model_get (model, &iter, 0, &s, -1);
+      if ((s != NULL) && (strcmp (s, text) == 0))
+	{
+	  g_free (s);
+	  gtk_combo_box_set_active (combo, i);
+	  return;
+	}
+      g_free (s);
+    }
 }
 
