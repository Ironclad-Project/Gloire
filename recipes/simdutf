#! /bin/sh

name=simdutf
version=9.0.0
revision=1
git_url="https://github.com/simdutf/simdutf.git"
commit=ca7acbcea967b5dcbab490066e99e3a6e6925539
hostdeps="gcc pkg-config"
deps="core-libs"

configure() {
    cmake_configure \
        -DSIMDUTF_TESTS=OFF
}

build() {
    cmake --build . -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" cmake --install .

    post_package_strip
}
