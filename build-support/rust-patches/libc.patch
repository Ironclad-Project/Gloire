+impl siginfo_t {
+    /// MEASURED: `si_addr` sits at byte offset 16 (size 8) in our 128-byte
+    /// `siginfo_t`, sharing that offset with `si_pid` -- which is the union that
+    /// makes the struct opaque here. The shadow below is libc's own idiom and
+    /// its three leading `c_int`s pad to exactly that offset.
+    pub unsafe fn si_addr(&self) -> *mut c_void {
+        #[repr(C)]
+        struct siginfo_si_addr {
+            _si_signo: c_int,
+            _si_errno: c_int,
+            _si_code: c_int,
+            si_addr: *mut c_void,
+        }
+        unsafe { (*(self as *const siginfo_t as *const siginfo_si_addr)).si_addr }
+    }
+}
