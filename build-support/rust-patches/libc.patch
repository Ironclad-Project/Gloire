+pub type gid_t = c_uint;
+pub type dev_t = c_ulong;
+// measured 8 bytes: Ironclad's __fsid_t is a PLAIN unsigned long, not the
+// `struct { int __val[2]; }` glibc-on-Linux uses.
+pub type fsid_t = c_ulong;
+
+// `((void *) 0)` in our dlfcn.h -- a POINTER, so it is not an integer constant.
+pub const RTLD_DEFAULT: *mut c_void = core::ptr::null_mut();
