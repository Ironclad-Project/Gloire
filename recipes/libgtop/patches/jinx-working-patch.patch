+   for more details.
+*/
+
+#include <config.h>
+#include <glibtop.h>
+#include <glibtop/uptime.h>
+
+#include <string.h>
+#include <time.h>
+#include <utmpx.h>
+
+static const unsigned long _glibtop_sysdeps_uptime =
+(1L << GLIBTOP_UPTIME_UPTIME) + (1L << GLIBTOP_UPTIME_BOOT_TIME);
+
+void
+_glibtop_init_uptime_s (glibtop *server)
+{
+	server->sysdeps.uptime = _glibtop_sysdeps_uptime;
+}
+
+/* Two independent sources, and each flag is set ONLY if its own source
+   answered -- glibtop's flags exist so a caller can tell a real value from
+   a zero, and a backend that sets them unconditionally is no better than
+   the stub it replaced.
+
+   uptime    CLOCK_MONOTONIC.  Ironclad's monotonic clock is the TSC scaled
+             to its resolution (arch/x86_64-limine/arch-clocks.adb), i.e. it
+             counts from reset, which is what every other system reports as
+             uptime.
+   boot_time the utmpx BOOT_TIME record.  epoch writes one at boot and
+             creates /run/utmp for it, which is also what `who -b` reads.  */
+void
+glibtop_get_uptime_s (glibtop *server, glibtop_uptime *buf)
+{
+	struct timespec ts;
+	struct utmpx id, *ut;
+
+	memset (buf, 0, sizeof (glibtop_uptime));
+
+	if (clock_gettime (CLOCK_MONOTONIC, &ts) == 0) {
+		buf->uptime = (double) ts.tv_sec + (double) ts.tv_nsec / 1.0e9;
+		buf->flags |= (1L << GLIBTOP_UPTIME_UPTIME);
+	}
+
+	memset (&id, 0, sizeof (id));
+	id.ut_type = BOOT_TIME;
+	setutxent ();
+	ut = getutxid (&id);
+	if (ut != NULL) {
+		buf->boot_time = (guint64) ut->ut_tv.tv_sec;
+		buf->flags |= (1L << GLIBTOP_UPTIME_BOOT_TIME);
+	}
+	endutxent ();
+}
