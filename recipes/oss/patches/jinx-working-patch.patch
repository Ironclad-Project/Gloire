+/*
+ * Dark green, green, dark orange, orange, dark red, red, background.
+ * These are the 16 bit GdkColor values the GTK1 version allocated, scaled
+ * to the 0..1 range GdkRGBA uses (0x30ff/0xffff and 0xbfff/0xffff).
+ */
+static const GdkRGBA vu_colors[7] = {
+  { 0.00, 0.19, 0.00, 1.0 },
+  { 0.00, 0.75, 0.00, 1.0 },
+  { 0.19, 0.19, 0.00, 1.0 },
+  { 0.75, 0.75, 0.00, 1.0 },
+  { 0.19, 0.00, 0.00, 1.0 },
+  { 0.75, 0.00, 0.00, 1.0 },
+  { 0.00, 0.00, 0.00, 1.0 }
+};
+
+G_DEFINE_TYPE (GtkVU, gtk_vu, GTK_TYPE_WIDGET)
+
+static gboolean
+gtk_vu_draw (GtkWidget * widget, cairo_t * cr)
+{
+  GtkVU *vu = GTK_VU (widget);
+  GtkAllocation alloc;
+  guint i;
+  int margin, y_size;
 
-/* Local data */
+  gtk_widget_get_allocation (widget, &alloc);
 
-static GtkWidgetClass *parent_class = NULL;
