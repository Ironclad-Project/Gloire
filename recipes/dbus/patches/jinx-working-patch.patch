diff --git dbus-clean/Doxyfile.in dbus-workdir/Doxyfile.in
index 750d966..a6439f8 100644
--- dbus-clean/Doxyfile.in
+++ dbus-workdir/Doxyfile.in
@@ -16,7 +16,7 @@ BRIEF_MEMBER_DESC      = YES
 REPEAT_BRIEF           = YES
 ALWAYS_DETAILED_SEC    = NO
 FULL_PATH_NAMES        = NO
-STRIP_FROM_PATH        = 
+STRIP_FROM_PATH        = @top_srcdir@ @top_builddir@
 INTERNAL_DOCS          = NO
 STRIP_CODE_COMMENTS    = YES
