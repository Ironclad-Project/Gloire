prepare() {
    autotools_recursive_regen
}

configure() {
        bash_cv_func_sigsetjmp=present \
    autotools_configure \
        CFLAGS="$TARGET_CFLAGS \
            -DDEFAULT_PATH_VALUE='\"/usr/local/sbin:/usr/local/bin:/usr/bin\"' \
            -DSTANDARD_UTILS_PATH='\"/usr/bin\"' \
            -DSYS_BASHRC='\"/etc/bash.bashrc\"' \
            -DSYS_BASH_LOGOUT='\"/etc/bash.bash_logout\"' \
            -DNON_INTERACTIVE_LOGIN_SHELLS \
        " \
        --with-curses \
        --enable-readline \
        --without-bash-malloc \
        --with-installed-readline
}

build() {
    make -j${parallelism}
}

package() {
    make install DESTDIR="${dest_dir}"
    ln -s bash "${dest_dir}${prefix}"/bin/sh
    ln -s bash "${dest_dir}${prefix}"/bin/rbash

    mkdir -p "${dest_dir}"/etc
    cp -v "${recipe_dir}"/bash.bashrc "${dest_dir}"/etc/
    cp -v "${recipe_dir}"/bash.bash_logout "${dest_dir}"/etc/

    install -Dm644 "${recipe_dir}"/dot.bashrc "${dest_dir}"/etc/skel/.bashrc
    install -Dm644 "${recipe_dir}"/dot.bash_profile "${dest_dir}"/etc/skel/.bash_profile
    install -Dm644 "${recipe_dir}"/dot.bash_logout "${dest_dir}"/etc/skel/.bash_logout

    sed -i -e "s|/base_dir/sources/bash/examples/loadables|.|g" \
           -e "s|/base_dir/sources/bash|${prefix}/include/bash|g" \
           -e "s|/build_dir/builds/bash|${prefix}/lib/bash|g" \
           -e "s| -ffile-prefix-map=[^ ]*||g" \
        "${dest_dir}${prefix}"/lib/bash/Makefile.inc

    post_package_strip

    install_hook_add 'for _sh in /bin/bash /usr/bin/bash /bin/rbash /usr/bin/rbash /bin/sh /usr/bin/sh; do
    grep -qxF "${_sh}" /etc/shells 2>/dev/null || echo "${_sh}" >>/etc/shells
done'
    generate_info_hooks
}
