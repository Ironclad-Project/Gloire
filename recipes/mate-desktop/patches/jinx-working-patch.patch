diff --git mate-desktop-clean/meson.build mate-desktop-workdir/meson.build
index 8a22ca9..5dc3ea6 100644
--- mate-desktop-clean/meson.build
+++ mate-desktop-workdir/meson.build
@@ -75,7 +75,12 @@ x11_dep = dependency('x11', required: true)
 randr_dep = dependency('xrandr', version: '>= 1.3', required: false)
 config_h.set('HAVE_RANDR', randr_dep.found())
 iso_codes = dependency('iso-codes')
-iso_codes_prefix = iso_codes.get_pkgconfig_variable('prefix')
+# pkg-config prefixes a cross build's VARIABLE output with the sysroot, which is
+# right for finding files at build time but wrong for a path compiled into the
+# library as a RUNTIME lookup root: ISO_CODES_PREFIX ends up /sysroot/usr, which
+# does not exist on the target, breaking every iso-codes XML and locale lookup.
+# iso-codes installs under our own prefix, so use that.
+iso_codes_prefix = matedt_prefix
