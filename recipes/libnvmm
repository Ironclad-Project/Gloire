#! /bin/sh

name=libnvmm
skip_pkg_check=yes
version=0.0git
revision=3
git_url="https://codeberg.org/Ironclad/libnvmm.git"
commit=78dda65b07a9f758f0b5c023a30e29f24b5503d3
hostdeps="gcc pkg-config"
deps="core-libs"

if [ "${JINX_ARCH}" = x86_64 ]; then

configure() {
