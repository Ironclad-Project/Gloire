#! /bin/sh

version=2.2.1
revision=4
tarball_url="https://ftp.gnu.org/gnu/wget/wget2-${version}.tar.gz"
tarball_blake2b="dccd9db63a237055377fb78e36ba36f357f5ec47b999e74aeffc170e3918a9d16df9a775b8836139e0640682eefe1d96d8bf6c7278b556ae9182039fa5dd90c0"
imagedeps="gperf"
hostdeps="gcc pkg-config"
deps="core-libs gnutls ca-certificates"

prepare() {
    autotools_recursive_regen
}

configure() {
    autotools_configure
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    mkdir "${dest_dir}/etc"
    cat >> "${dest_dir}/etc/wgetrc" << EOF

# default root certs location
ca_certificate=/etc/ssl/certs/ca-certificates.crt
EOF

    ln -s wget2 "${dest_dir}${prefix}"/bin/wget

    post_package_strip
}
