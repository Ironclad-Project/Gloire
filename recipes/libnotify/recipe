#! /bin/sh

version=0.8.9
revision=2
tarball_url="https://download.gnome.org/sources/libnotify/0.8/libnotify-${version}.tar.xz"
tarball_blake2b="35da439998d07051e0be92710564560728b020e5cb56630865828ed6b4070f1e5dc813556cc7a33a44916a09bd143f43a21e6b303bd378e130b3be541ce8adef"
imagedeps="libglib2.0-dev-bin libglib2.0-bin"
hostdeps="gcc pkg-config"
deps="core-libs glib2 gdk-pixbuf"

configure() {
    meson_configure \
        -Dgtk_doc=false \
        -Dtests=false \
        -Dintrospection=disabled
}

build() {
    meson compile --verbose -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
