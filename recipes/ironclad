#! /bin/sh

name=ironclad
skip_pkg_check=yes
version=0.0git
revision=52
git_url="https://codeberg.org/Ironclad/Ironclad.git"
commit=7a3b0549d5de79d564e415f99b339c19d30f4eb3
source_hostdeps="autoconf automake pkg-config"
imagedeps="gprbuild"
hostdeps="gcc pkg-config"
deps="core-libs"

early_prepare() {
    ./bootstrap
}

prepare() {
    autotools_recursive_regen
}

configure() {
    autotools_configure_noflags
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install
}
