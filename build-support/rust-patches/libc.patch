# The measured `ironclad` module for the libc crate, and the one arm that selects it.
# Generated from Ironclad's own glibc headers; see audit/tools/ironclad-abi.
#
# rust-patch-versions: 0.2.*
--- a/src/unix/ironclad/mod.rs
+++ b/src/unix/ironclad/mod.rs
@@ -0,0 +1,2013 @@
+//! Ironclad. The C library is glibc, but the kernel ABI is not Linux's: O_RDONLY
+//! is 1, SEEK_SET is 1, AF_INET6 is 2, sa_family_t is four bytes, and errno has a
+//! range of its own. Derived from Ironclad's glibc headers, not adapted.
+#![allow(dead_code)]
+
+use crate::c_schar;
+use crate::prelude::*;
