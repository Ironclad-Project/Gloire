#! /bin/sh

version=2.67.1
revision=2
git_url="https://github.com/fastfetch-cli/fastfetch.git"
commit=4dd2f2d34bf80f3e66b26d3869467de88ee1ca52
hostdeps="gcc pkg-config"
deps="core-libs sqlite zlib"

configure() {
    cmake_configure \
        -DBUILD_FLASHFETCH='OFF' \
        -DENABLE_SQLITE3='ON' \
        -DMODULE_DISABLE_LOCALIP='ON' \
        -DMODULE_DISABLE_PUBLICIP='ON'
}

build() {
    cmake --build . -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" cmake --install .

    post_package_strip
}
