#! /bin/sh

version=19rc1
revision=1
tarball_url="https://ftp.postgresql.org/pub/source/v${version}/postgresql-${version}.tar.bz2"
tarball_blake2b="41e04b6aae897fc74d01a71d8244c01e8deeaa307c69ff4ac7bfa56de8657b037a6ef500144a071ccb43b0dd1af27636e6e233826129dbfd053fb78b8ba6b089"
imagedeps="binutils"
hostdeps="gcc pkg-config"
deps="core-libs icu readline zlib openssl zstd libxml2 libxslt lz4 e2fsprogs"

configure() {
    meson_configure \
        -Duuid=e2fs \
        -Drpath=false \
        -Dsystem_tzdata="${prefix}"/share/zoneinfo \
        -Dtap_tests=disabled \
        -Dbonjour=disabled \
        -Dbsd_auth=disabled \
        -Ddocs_pdf=disabled \
        -Dgssapi=disabled \
        -Dlibcurl=disabled \
        -Dldap=disabled \
        -Dlibnuma=disabled \
        -Dliburing=disabled \
        -Dpam=disabled \
        -Dplperl=disabled \
        -Dplpython=disabled \
        -Dpltcl=disabled \
        -Dselinux=disabled \
        -Dsystemd=disabled
}

build() {
    meson compile --verbose -j${parallelism}

    meson compile --verbose -j${parallelism} docs
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    DESTDIR="${dest_dir}" meson compile --verbose install-docs

    rm -f "${dest_dir}${prefix}"/lib/libpq.a \
          "${dest_dir}${prefix}"/lib/libecpg.a \
          "${dest_dir}${prefix}"/lib/libecpg_compat.a \
          "${dest_dir}${prefix}"/lib/libpgtypes.a

    post_package_strip
}
