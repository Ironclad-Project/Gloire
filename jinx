clean_sources() {
    force_remove "${base_dir}"/${_sources_root}/$1
    force_remove "${base_dir}"/${_sources_root}/$1-clean
    force_remove "${base_dir}"/${_sources_root}/$1-workdir
    force_remove "${base_dir}"/${_sources_root}/$1.version
    force_remove "${base_dir}"/${_sources_root}/$1.patched
    force_remove "${base_dir}"/${_sources_root}/$1.prepared
    force_remove "${base_dir}"/${_sources_root}/$1.built
}

do_source() {
    eval "$(source_source_recipe "$1" "$2")"

    eval "$(get_real_source_dir)"

    local cross_compile=yes
    local container_pkgs=
    local sysroot=
    local imgroot=
    local container_sources_ro=
    local container_base_dir_ro=
    prepare_container

    if [[ ! -f "${base_dir}/${_sources_root}/$1.version" || $(cat "${base_dir}/${_sources_root}/$1.version") != "${version}" ]]; then
        tracked_subshell '
            local allow_network=yes
            local container_base_dir_ro=
            clean_sources '$1'
            [[ ${is_local_package} == true ]] \
                || [[ -n ${tarball_sha256} && ${tarball_sha256} == "?" ]] \
                || [[ -n ${tarball_sha512} && ${tarball_sha512} == "?" ]] \
                || [[ -n ${tarball_blake2b} && ${tarball_blake2b} == "?" ]] \
                || local container_base_dir_ro="-o ro"
            run_in_container internal-fetch '$1' '$2'
            echo "${version}" >"${base_dir}"/${_sources_root}/'$1'.version
        '
    fi

    if [[ ! -f "${base_dir}/${_sources_root}/$1.patched" ]]; then
        tracked_subshell '
            if [[ ${is_local_package} != true && ${is_sourceless_package} != true ]]; then
                local allow_network=yes
                run_in_container internal-patch '$1' '$2'
            fi
            touch "${base_dir}"/${_sources_root}/'$1'.patched
        '
    fi

    if [[ ! -f "${base_dir}/${_sources_root}/$1.prepared" ]]; then
        tracked_subshell '
            local container_base_dir_ro=
            if [[ ${is_sourceless_package} != true ]]; then
                [[ ${is_local_package} == true ]] || local container_base_dir_ro="-o ro"
                run_in_container internal-prepare '$1' '$2'
            fi
            touch "${base_dir}"/${_sources_root}/'$1'.prepared
        '
    fi

    destroy_container
}

do_rebuild() {
    force_remove "${build_dir}"/builds/"$1"

    do_pkg "$1"
}

do_host_rebuild() {
    force_remove "${build_dir}"/host-builds/"$1"

    do_host_pkg "$1"
}

do_regen() {
    eval "$(source_source_recipe "$1" "$2")"

    if [[ -n ${from_source} ]]; then
        if [[ ${_from_source_dir} == host-recipes ]]; then
            die "$0: recipe '$1' uses from_source/from_host_source; regen its source with: $0 regen host:${from_source}"
        else
            die "$0: recipe '$1' uses from_source/from_host_source; regen its source with: $0 regen ${from_source}"
        fi
    fi
    [[ -f "${base_dir}/${_sources_root}/$1.patched" ]] || die "cannot regenerate non-built package"

    eval "$(get_real_source_dir)"

    make_temp
    local patch_file="${tmp}"

    if [[ ${is_local_package} != true ]]; then
        cd "${base_dir}/${_sources_root}"

        # exclude version control dirs
        make_temp -d
        local vc_dir_clean="${tmp}"
        force_remove "${vc_dir_clean}"
        make_temp -d
        local vc_dir_workdir="${tmp}"
        force_remove "${vc_dir_workdir}"

        if [[ -n ${git_url} ]]; then
            mv $1-clean/.git "${vc_dir_clean}"
            mv $1-workdir/.git "${vc_dir_workdir}"
        fi

        git diff --no-index --no-prefix $1-clean $1-workdir >"${patch_file}" || true

        if [[ -n ${git_url} ]]; then
            mv "${vc_dir_clean}" $1-clean/.git
            mv "${vc_dir_workdir}" $1-workdir/.git
        fi

        if [[ -s "${patch_file}" ]]; then
            mkdir -p "${base_dir}/${_from_source_dir}/$1/patches"
            mv "${patch_file}" "${base_dir}/${_from_source_dir}/$1/patches/jinx-working-patch.patch"
        fi

        cd "${base_dir}"

        force_remove "${source_dir}"
        cp -rp "${base_dir}"/${_sources_root}/$1-workdir "${source_dir}"
    fi

    force_remove "${base_dir}"/${_sources_root}/$1.prepared

    local cross_compile=yes
    local container_pkgs=
    local sysroot=
    local imgroot=
    local container_sources_ro=
    local container_base_dir_ro=
    prepare_container
    run_in_container internal-prepare "$1" "$2"
    destroy_container
}

do_host_pkg() {
    eval "$(include_recipe "${base_dir}"/host-recipes/$1)"

    echo "* building host package: $name"

    if [[ -n ${from_source} ]]; then
        tracked_subshell 'do_source "${from_source}" "${_from_source_dir}"'
    else
        tracked_subshell 'do_source "${name}" host-recipes'
    fi

    local cross_compile=yes
    local container_pkgs=
    local sysroot=
    local imgroot=
    local container_base_dir_ro=
    prepare_container

    local container_sources_ro="-o ro"
    if [[ ! -d "${build_dir}/host-builds/$1" ]]; then
        run_in_container internal-configure-host $1
    fi
    run_in_container internal-build-host $1
    force_remove "${build_dir}"/host-pkgs/$1
    run_in_container internal-package-host $1

    destroy_container

    if [[ ${JINX_CLEAN_WORKDIRS} == yes ]]; then
        if [[ ${clean_workdirs} != no ]]; then
            force_remove "${build_dir}"/host-builds/$1

            if [[ -z ${from_source} ]]; then
                eval "$(source_source_recipe "$1" host-recipes)"
            else
                eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")"
            fi

            eval "$(get_real_source_dir)"

            if [[ ${is_sourceless_package} != true && ${is_local_package} != true ]]; then
                clean_sources "${name}"
            fi
        fi
    fi
}

do_pkg() {
    eval "$(include_recipe "${base_dir}"/recipes/$1)"

    echo "* building package: $name"

    if [[ -n ${from_source} ]]; then
        local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
    fi

    if [[ ! -f "${build_dir}/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps" ]]; then
        force_remove "${build_dir}"/builds/"$1"
        if [[ -z ${from_source} ]] \
           && [[ -f "${base_dir}/${_sources_root}/$1.built" ]] \
           && [[ $(cat "${base_dir}/${_sources_root}/$1.built") != "${version}_${revision}" ]]; then
            tracked_subshell 'clean_sources "${name}"'
        fi
    fi

    if [[ -n ${from_source} ]]; then
        tracked_subshell 'do_source "${from_source}" "${_from_source_dir}"'
    else
        tracked_subshell 'do_source "${name}" recipes'
    fi

    echo "${version}_${revision}" >"${base_dir}"/${_sources_root}/$1.built

    local container_pkgs=
    local sysroot=
    local imgroot=
    local container_base_dir_ro=
    prepare_container

    local container_sources_ro="-o ro"
    if [[ ! -d "${build_dir}/builds/$1" ]]; then
        run_in_container internal-configure $1
    fi
    run_in_container internal-build $1
    force_remove "${build_dir}"/pkgs/$1
    run_in_container internal-package $1

    destroy_container

    local xbps_deps=""
    local dep
    for dep in ${deps}; do
        local bootstrap_pkg=$(eval "$(include_recipe "${base_dir}"/recipes/${dep})" && echo "${bootstrap_pkg}")
        if [[ ${bootstrap_pkg} == yes ]]; then
            continue
        fi

        local xbps_deps="${xbps_deps} ${dep}>=0.0"
    done

    local dest_dir="${build_dir}/pkgs/${name}"

    cd "${build_dir}"/pkgs
        XBPS_ARCH=invalid \
        XBPS_TARGET_ARCH="${JINX_ARCH}" \
    xbps-create \
        -A $JINX_ARCH \
        -s ${name} \
        -n ${name}-${version}_${revision} \
        -D "${xbps_deps}" \
        "${dest_dir}"

    force_remove "${dest_dir}"

        XBPS_ARCH=invalid \
        XBPS_TARGET_ARCH="${JINX_ARCH}" \
    xbps-rindex \
        -a "${build_dir}"/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps \
        -f

    if [[ ${JINX_CLEAN_WORKDIRS} == yes ]]; then
        if [[ ${clean_workdirs} != no ]]; then
            force_remove "${build_dir}"/builds/$1

            if [[ -z ${from_source} ]]; then
                eval "$(source_source_recipe "$1" recipes)"
            else
                eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")"
            fi

            eval "$(get_real_source_dir)"

            if [[ ${is_sourceless_package} != true && ${is_local_package} != true ]]; then
                clean_sources "${name}"
            fi
        fi
    fi
}

cmd_build() {
    local ppkg
    for ppkg in "$@"; do
        local pkg
        if [[ ${ppkg} == host:* ]]; then
            for pkg in $(cd "${base_dir}/host-recipes" && echo ${ppkg#host:}); do
                tracked_subshell 'do_host_pkg "${pkg}"'
            done
        else
            for pkg in $(cd "${base_dir}/recipes" && echo ${ppkg}); do
                tracked_subshell 'do_pkg "${pkg}"'
            done
        fi
    done
}

do_build_if_needed() {
    eval "$(include_recipe "${base_dir}"/recipes/$1)"
    if [[ -n ${from_source} ]]; then
        local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
    fi

    if [[ ! -f "${build_dir}/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps" ]]; then
        tracked_subshell 'do_pkg "'$1'"'
    fi
}

do_host_build_if_needed() {
    if [[ ! -d "${build_dir}/host-pkgs/${hostdep}" ]]; then
        tracked_subshell 'do_host_pkg "'$1'"'
    fi
}

do_update() {
    local with_build="$1"
    shift
    eval "$(include_recipe "${base_dir}"/recipes/$1)"
    if [[ -n ${from_source} ]]; then
        local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
    fi

    # Up to date already? Nothing to do.
    if [[ -f "${build_dir}/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps" ]]; then
        return 0
    fi

    # Not previously built? Skip unless caller asked to build missing ones.
    if [[ ${with_build} != yes ]] && ! compgen -G "${build_dir}/pkgs/${name}-*_*.${JINX_ARCH}.xbps" >/dev/null; then
        return 0
    fi

    local -A _hostdeps_collected

    get_hostdeps_file

    local hostdep
    for hostdep in "${!_hostdeps_collected[@]}"; do
        tracked_subshell 'do_host_build_if_needed "${hostdep}"'
    done
    local builddeps_var="$(tracked_subshell 'get_builddeps "${name}"')"
    local dep
    for dep in ${builddeps_var}; do
        tracked_subshell 'do_build_if_needed "${dep}"'
    done
}

cmd_update() {
    local with_build=no
    if [[ ${1-} == "-b" ]]; then
        local with_build=yes
        shift 1
    fi
    if [[ -z ${1-} ]]; then
        set -- '*'
    fi

    local ppkg
    for ppkg in "$@"; do
        local pkg
        for pkg in $(cd "${base_dir}/recipes" && echo ${ppkg}); do
            tracked_subshell 'do_update "${with_build}" "${pkg}"'
        done
    done
}

cmd_dry_run() {
    # Print all packages that would be built (space separated), but only those
    # that are not already built in the build cache. Host packages (prefixed 'host:')
    # are mentioned inline just before the regular package that needs them,
    # and only if they haven't been mentioned before.
    if [[ -z ${1-} ]]; then
        set -- '*'
    fi

    # Expand all package patterns upfront
    local all_packages=""
    local ppkg
    for ppkg in "$@"; do
        local pkg
        for pkg in $(cd "${base_dir}/recipes" && echo ${ppkg}); do
            local all_packages="${all_packages} ${pkg}"
        done
    done

    # Build a lookup table: package -> deps
    local -A pkg_deps
    for pkg in ${all_packages}; do
        pkg_deps[$pkg]=$(eval "$(include_recipe "${base_dir}/recipes/${pkg}")" && echo "${deps} ${builddeps}")
    done

    # Recursively collect all transitive deps
    local -A collected

    collect_all_deps() {
        local pkg="$1"
        [[ -n ${collected[$pkg]+x} ]] && return
        collected[$pkg]=1

        # Lazily fill pkg_deps for transitively-discovered packages
        [[ -n ${pkg_deps[$pkg]+x} ]] || pkg_deps[$pkg]=$(eval "$(include_recipe "${base_dir}/recipes/${pkg}")" && echo "${deps} ${builddeps}")

        local dep
        for dep in ${pkg_deps[$pkg]}; do
            [[ -n $dep ]] && collect_all_deps "$dep"
        done
    }

    for pkg in ${all_packages}; do
        collect_all_deps "${pkg}"
    done

    # Now check which ones are unbuilt
    local all_unbuilt=""
    local dep
    for dep in "${!collected[@]}"; do
        eval "$(include_recipe "${base_dir}"/recipes/"${dep}")"
        if [[ -n ${from_source} ]]; then
            local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
        fi
        if [[ ! -f "${build_dir}/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps" ]]; then
            local all_unbuilt="${all_unbuilt} ${dep}"
        fi
    done

    # Collect host deps for all unbuilt packages
    local -A pkg_hostdeps
    for pkg in ${all_unbuilt}; do
        local hostdeps="$(eval "$(include_recipe "${base_dir}/recipes/${pkg}")" && echo "${hostdeps} ${hostrundeps}")"
        if [[ -n ${hostdeps} ]]; then
            pkg_hostdeps[$pkg]=$hostdeps
        fi
    done

    # Build graph for topo sort
    local graph=
    for dep in ${all_unbuilt}; do
        # Only include deps that are also unbuilt
        local unbuilt_deps_of_dep=""
        local d
        for d in ${pkg_deps[$dep]}; do
            if [[ " ${all_unbuilt} " == *" ${d} "* ]]; then
                local unbuilt_deps_of_dep="${unbuilt_deps_of_dep} ${d}"
            fi
        done
        local graph="${graph}${dep}:${unbuilt_deps_of_dep}
"
    done

    local topo_sort_result="$(topo_sort "${graph}")"

    # Emit in topological order with host deps inline
    local pending_list=""
    local emitted_hostdeps=" "

    for dep in ${topo_sort_result}; do
        # Emit host deps for this package first
        if [[ -n ${pkg_hostdeps[$dep]+x} ]]; then
            local hostdep
            for hostdep in ${pkg_hostdeps[$dep]}; do
                if [[ ${emitted_hostdeps} != *" ${hostdep} "* ]]; then
                    if [[ ! -d "${build_dir}/host-pkgs/${hostdep}" ]]; then
                        local pending_list="${pending_list} host:${hostdep}"
                    fi
                    local emitted_hostdeps="${emitted_hostdeps}${hostdep} "
                fi
            done
        fi
        # Then emit the package itself
        local pending_list="${pending_list} ${dep}"
    done

    # Print packages preserving order, space separated, with global deduplication
    printf '%s\n' ${pending_list} | awk '!seen[$0]++{printf "%s ", $0} END{print ""}'
}

cmd_download() {
    if [[ -z ${JINX_REPO_URL-} ]]; then
        die "$0: JINX_REPO_URL not set in Jinxfile"
    fi

    if [[ -z ${1-} ]]; then
        die "$0: download requires at least one package name"
    fi

    # Expand package patterns
    local all_packages=""
    local ppkg
    for ppkg in "$@"; do
        local pkg
        for pkg in $(cd "${base_dir}/recipes" && echo ${ppkg}); do
            local all_packages="${all_packages} ${pkg}"
        done
    done

    # Collect transitive deps
    local -A pkg_deps
    for pkg in $(cd "${base_dir}/recipes" && echo *); do
        pkg_deps[$pkg]=$(eval "$(include_recipe "${base_dir}/recipes/${pkg}")" && echo "${deps} ${builddeps}")
    done

    local -A collected

    collect_all_deps() {
        local pkg="$1"
        [[ -n ${collected[$pkg]+x} ]] && return
        collected[$pkg]=1
        local dep
        for dep in ${pkg_deps[$pkg]}; do
            [[ -n $dep ]] && collect_all_deps "$dep"
        done
    }

    for pkg in ${all_packages}; do
        collect_all_deps "${pkg}"
    done

    # Determine which packages are missing from pkgs/
    local download_list=""
    local dep
    for dep in "${!collected[@]}"; do
        eval "$(include_recipe "${base_dir}"/recipes/"${dep}")"
        if [[ -n ${from_source} ]]; then
            local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
        fi
        local pkg_filename="${name}-${version}_${revision}.${JINX_ARCH}.xbps"
        if [[ ! -f "${build_dir}/pkgs/${pkg_filename}" ]]; then
            local download_list="${download_list} ${pkg_filename}"
        fi
    done

    if [[ -z ${download_list} ]]; then
        echo "* all packages already present in pkgs/"
        return
    fi

    # Fetch repo index for checksum verification
    echo "* fetching repository index..."
    make_temp
    local repodata_path="${tmp}"
    curl -fL -o "${repodata_path}" "${JINX_REPO_URL}/${JINX_ARCH}-repodata" \
        || die "$0: failed to fetch repository index from ${JINX_REPO_URL}"

    make_temp
    local index_plist="${tmp}"
    zstdcat "${repodata_path}" | tar -xOf - index.plist >"${index_plist}"

    # Download each missing package
    local pkg_file
    for pkg_file in ${download_list}; do
        echo "* downloading ${pkg_file}..."
        make_temp
        local dl_path="${tmp}"
        curl -fL -o "${dl_path}" "${JINX_REPO_URL}/${pkg_file}" \
            || die "$0: failed to download ${pkg_file} from ${JINX_REPO_URL}"

        # Verify SHA256 against repodata
        local pkg_name="${pkg_file%%-[0-9]*}"
        local expected_sha256="$(sed -n "/<key>${pkg_name}<\\/key>/,/<key>filename-sha256<\\/key>/{
            /<key>filename-sha256<\\/key>/{n;s/.*<string>\\(.*\\)<\\/string>.*/\\1/p;}
        }" "${index_plist}")"

        if [[ -n ${expected_sha256} ]]; then
            local actual_sha256="$(sha256sum "${dl_path}")"
            local actual_sha256="${actual_sha256%% *}"
            if [[ ${actual_sha256} != "${expected_sha256}" ]]; then
                die "$0: SHA256 mismatch for ${pkg_file}:
  expected '${expected_sha256}'
  got      '${actual_sha256}'"
            fi
        fi

        mv "${dl_path}" "${build_dir}/pkgs/${pkg_file}"

        # Re-index this package
        XBPS_ARCH=invalid \
        XBPS_TARGET_ARCH="${JINX_ARCH}" \
        xbps-rindex \
            -a "${build_dir}/pkgs/${pkg_file}" \
            -f
    done

    echo "* download complete"
}

cmd_regen() {
    local ppkg
    for ppkg in "$@"; do
        local pkg
        if [[ ${ppkg} == host:* ]]; then
            for pkg in $(cd "${base_dir}/host-recipes" && echo ${ppkg#host:}); do
                tracked_subshell 'do_regen "${pkg}" host-recipes'
            done
        else
            for pkg in $(cd "${base_dir}/recipes" && echo ${ppkg}); do
                tracked_subshell 'do_regen "${pkg}" recipes'
            done
        fi
    done
}

do_run_in() {
    local pkg="$1"
    local cmd_file="$2"

    eval "$(include_recipe "${base_dir}"/recipes/${pkg})"

    mkdir -p "${build_dir}"/builds/${name}

    if [[ -n ${from_source} || -n ${tarball_url} || -n ${git_url} || -n ${source_dir} ]]; then
        if [[ -n ${from_source} ]]; then
            local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
            local source_dir="$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$source_dir")"
        else
            local from_source=${name}
        fi

        if [[ -z ${source_dir} ]]; then
            local source_dir="${base_dir}"/${_sources_root}/${from_source}
        else
            local source_dir="${base_dir}"/"${source_dir}"
        fi
    fi

    local prefix="/usr"
    local sysroot="/sysroot"

    cd "${build_dir}"/builds/${name}

    set --
    . "${cmd_file}"
}

cmd_run_in() {
    if [[ -z ${1-} ]]; then
        die "$0: run-in requires a recipe name"
    fi
    local recipe_glob="$1"
    shift 1
    if [[ -z ${1-} ]]; then
        die "$0: run-in requires a command to run"
    fi

    local run_in_recipe
    for run_in_recipe in $(cd "${base_dir}/recipes" && echo ${recipe_glob}); do
        if [[ ! -f "${base_dir}/recipes/${run_in_recipe}/recipe" ]]; then
            die "$0: recipe '${run_in_recipe}' not found"
        fi

        eval "$(include_recipe "${base_dir}"/recipes/${run_in_recipe})"

        if [[ -n ${from_source} ]]; then
            tracked_subshell 'do_source "${from_source}" "${_from_source_dir}"'
        else
            tracked_subshell 'do_source "${name}" recipes'
        fi

        make_temp
        local cmd_file="${tmp}"
        {
            printf 'exec'
            local arg
            for arg in "$@"; do
                local escaped="$arg"
                local escaped="${escaped//\\/\\\\}"
                local escaped="${escaped//\"/\\\"}"
                local escaped="${escaped//\`/\\\`}"
                printf ' "%s"' "$escaped"
            done
            printf '\n'
        } >"${cmd_file}"
        local cmd_file_inner="/base_dir/.jinx-cache/tmp/$(basename "${cmd_file}")"

        local container_pkgs=
        local sysroot=
        local imgroot=
        prepare_container

        mkdir -p "${build_dir}"/builds/${name}

        local container_sources_ro=
        local container_base_dir_ro=
        local allow_network=yes
        run_in_container internal-run-in "${run_in_recipe}" "${cmd_file_inner}"

        destroy_container
    done
}

cmd_rebuild() {
    local ppkg
    for ppkg in "$@"; do
        local pkg
        if [[ ${ppkg} == host:* ]]; then
            for pkg in $(cd "${base_dir}/host-recipes" && echo ${ppkg#host:}); do
                tracked_subshell 'do_host_rebuild "${pkg}"'
            done
        else
            for pkg in $(cd "${base_dir}/recipes" && echo ${ppkg}); do
                tracked_subshell 'do_rebuild "${pkg}"'
            done
        fi
    done
}

cmd_install() {
    local force_install=""
    if [[ ${1-} == "-f" ]]; then
        local force_install="$1"
        shift 1
    fi
    if [[ -z ${1-} ]]; then
        die "$0: install requires a sysroot directory"
    fi
    local sysroot="$1"
    shift 1
    mkdir -m 755 -p "${sysroot}"

    local pkgs_to_install=""
    local ppkg
    for ppkg in "$@"; do
        local pkg
        for pkg in $(cd "${base_dir}/recipes" && echo ${ppkg}); do
            local bootstrap_pkg=$(eval "$(include_recipe "${base_dir}"/recipes/${pkg})" && echo "${bootstrap_pkg}")
            if [[ ${bootstrap_pkg} == yes ]]; then
                continue
            fi

            local pkgs_to_install="${pkgs_to_install} ${pkg}"
        done
    done

    local files_to_ignore='\.keep
\.plist
/INSTALL
/REMOVE'

    make_temp
    local all_files="${tmp}"

    for pkg in ${pkgs_to_install}; do
        echo "* installing ${pkg}..."

        tracked_subshell '
        eval "$(include_recipe "${base_dir}"/recipes/${pkg})"

        if [[ -n ${from_source} ]]; then
            local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
        fi

        if [[ ! -f "${build_dir}/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps" ]]; then
            if [[ $(id -u) == 0 ]]; then
                die "$0: a package needs to be built, but Jinx was invoked as root"
            fi
            tracked_subshell '\''do_pkg "${pkg}"'\''
        fi

        # xbps seems to only install the package every second time when reinstalling.
        # Remove the package to be sure it gets reinstalled.
        if [[ -n ${force_install} ]]; then
            XBPS_ARCH=invalid \
            XBPS_TARGET_ARCH="${JINX_ARCH}" \
                xbps-remove -Ffy -r "${sysroot}" ${pkg} >/dev/null 2>&1 || true
        fi

        XBPS_ARCH=invalid \
        XBPS_TARGET_ARCH="${JINX_ARCH}" \
            xbps-install -y $force_install -r "${sysroot}" -R "${build_dir}"/pkgs ${pkg} >/dev/null 2>&1

        zstdcat "${build_dir}"/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps | tar -tf - | ( grep -v "${files_to_ignore}" || true ) >>"${all_files}"
        '
    done

    echo "* checking for conflicts..."

    make_temp
    local all_files_sorted="${tmp}"

    make_temp
    local all_files_uniq="${tmp}"

    sort <"${all_files}" >"${all_files_sorted}"
    uniq <"${all_files_sorted}" >"${all_files_uniq}"

    local dup_elements="$(comm -23 "${all_files_sorted}" "${all_files_uniq}" | uniq)"

    if [[ -n ${dup_elements} ]]; then
        echo "* error: duplicate files were found."
        local elem
        for elem in ${dup_elements}; do
            echo "  file path: ${elem}"
            printf "  in packages:"
            for pkg in ${pkgs_to_install}; do
                tracked_subshell '
                eval "$(include_recipe "${base_dir}"/recipes/${pkg})"

                if [[ -n ${from_source} ]]; then
                    local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
                fi

                if zstdcat "${build_dir}"/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps | tar -tf - | ( grep -v "${files_to_ignore}" || true ) | grep -q "${elem}"; then
                    printf " ${pkg}"
                fi
                '
            done
            printf "\n"
        done
        exit 1
    fi
}

reinit_container() {
    force_remove "$JINX_CACHE_DIR/sets" "$JINX_CACHE_DIR/apt-cache"

    mkdir -p "${apt_cache}"
    mkdir -p "${JINX_CACHE_DIR}/tmp"

    mkdir -p "$JINX_CACHE_DIR/sets/.image"

    local SHA256_COMMAND="sha256sum"
    if ! command -v "${SHA256_COMMAND%% *}" >/dev/null 2>&1; then
        local SHA256_COMMAND="sha256"
        if ! command -v "${SHA256_COMMAND%% *}" >/dev/null 2>&1; then
            die "error: Cannot find sha256(sum) command"
        fi
    fi

    # Build xbps
    wget -O "${JINX_CACHE_DIR}/xbps-${XBPS_VERSION}.tar.gz" https://github.com/void-linux/xbps/archive/${XBPS_VERSION}.tar.gz
    if ! "${SHA256_COMMAND}" "${JINX_CACHE_DIR}/xbps-${XBPS_VERSION}.tar.gz" | grep "${XBPS_SHA256SUM}" >/dev/null 2>&1; then
        die "Jinx: Failed to verify XBPS tarball"
    fi

    tracked_subshell '

    cd "$JINX_CACHE_DIR"
    tar -zxf xbps-${XBPS_VERSION}.tar.gz
    cd xbps-${XBPS_VERSION}

    sed "s/&& DEBUG=yes/&& DEBUG=no/g" configure >configure.sed
    mv configure.sed configure
    chmod +x configure

    CFLAGS="-O2 -pipe -Wno-error" ./configure --verbose --prefix="$JINX_CACHE_DIR/xbps" --localstatedir=/var

    sed "/DBDIR/d" data/Makefile >data/Makefile.sed
    mv data/Makefile.sed data/Makefile

    sed "s/-lxml2/-lxml2 -llzma -lm/g" config.mk >config.mk.sed
    mv config.mk.sed config.mk

    if command -v gmake >/dev/null 2>&1; then
        local MAKE=gmake
    else
        local MAKE=make
    fi

    ${MAKE} -j${parallelism}
    ${MAKE} install

    cd ..
    force_remove xbps-${XBPS_VERSION}*

    '

    cat >"$JINX_CACHE_DIR/nochown.c" <<EOF
#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>

int chown(const char *pathname, uid_t owner, gid_t group) {
    (void)pathname; (void)owner; (void)group;
    return 0;
}

int fchown(int fd, uid_t owner, gid_t group) {
    (void)fd; (void)owner; (void)group;
    return 0;
}

int lchown(const char *pathname, uid_t owner, gid_t group) {
    (void)pathname; (void)owner; (void)group;
    return 0;
}

int fchownat(int dirfd, const char *pathname,
             uid_t owner, gid_t group, int flags) {
    (void)dirfd; (void)pathname; (void)owner; (void)group; (void)flags;
    return 0;
}
EOF
    cc -O2 -pipe -std=gnu99 -Wall -Wextra -fPIC -shared -nostdlib "$JINX_CACHE_DIR/nochown.c" -o "$JINX_CACHE_DIR/sets/.image/nochown.so"
    rm "$JINX_CACHE_DIR/nochown.c"

    local DEBOOTSTRAP_ARCH="$(uname -m)"
    case "${DEBOOTSTRAP_ARCH}" in
        i?86) local DEBOOTSTRAP_ARCH=i386 ;;
        x86_64) local DEBOOTSTRAP_ARCH=amd64 ;;
        arm*) local DEBOOTSTRAP_ARCH=armhf ;;
        aarch64) local DEBOOTSTRAP_ARCH=arm64 ;;
        loongarch64) local DEBOOTSTRAP_ARCH=loong64 ;;
        ppc64le) local DEBOOTSTRAP_ARCH=ppc64el ;;
    esac

    # Install debootstrap
    tracked_subshell '
        cd "${JINX_CACHE_DIR}"
        wget -O debootstrap.tar.gz https://salsa.debian.org/installer-team/debootstrap/-/archive/${debootstrap_version}/debootstrap-${debootstrap_version}.tar.gz
        if ! "${SHA256_COMMAND}" debootstrap.tar.gz | grep "${debootstrap_sha256sum}" >/dev/null 2>&1; then
            die "Jinx: Failed to verify debootstrap tarball"
        fi
        tar -zxf debootstrap.tar.gz
        make -C debootstrap-${debootstrap_version} DESTDIR="$(pwd -P)/debootstrap" install
        force_remove debootstrap.tar.gz debootstrap-${debootstrap_version}
        sed "s/HOST_ARCH=[^;#]*/HOST_ARCH=${DEBOOTSTRAP_ARCH}/g;s|DEBOOTSTRAP_DIR=/usr/share/debootstrap|DEBOOTSTRAP_DIR=\"$(pwd -P)/debootstrap/usr/share/debootstrap\"|g" debootstrap/usr/sbin/debootstrap >debootstrap.sed
        mv debootstrap.sed debootstrap/usr/sbin/debootstrap
        chmod +x debootstrap/usr/sbin/debootstrap
    '

    mkdir -p "$JINX_CACHE_DIR/sets/.image/var/cache/apt/archives"

    unshare --user --map-root-user --mount --pid --fork -- sh -c "
        set -e

        mount --bind '${apt_cache}' '$JINX_CACHE_DIR/sets/.image/var/cache/apt/archives'

        LD_PRELOAD='$JINX_CACHE_DIR/sets/.image/nochown.so' debootstrap \
            --foreign sid '$JINX_CACHE_DIR/sets/.image' https://snapshot.debian.org/archive/debian/${JINX_DEBIAN_SNAPSHOT}/
    "

    local dir
    for dir in dev proc sys run tmp var/tmp; do
        force_remove "${JINX_CACHE_DIR}/sets/.image/${dir}"
        mkdir -p "${JINX_CACHE_DIR}/sets/.image/${dir}"
    done

    rm "${JINX_CACHE_DIR}/sets/.image/etc/resolv.conf"
    echo localhost >"${JINX_CACHE_DIR}/sets/.image/etc/hostname"

    run_in_container1 "$JINX_CACHE_DIR/sets/.image" /debootstrap/debootstrap --second-stage

    echo 'en_US.UTF-8 UTF-8' > "$JINX_CACHE_DIR/sets/.image/etc/locale.gen"
    echo 'APT::Install-Suggests "0";
APT::Install-Recommends "0";
APT::Sandbox::User "root";
Acquire::Check-Valid-Until "0";' >> "$JINX_CACHE_DIR/sets/.image/etc/apt/apt.conf"

    run_in_container1 "$JINX_CACHE_DIR/sets/.image" apt-get update
    run_in_container1 "$JINX_CACHE_DIR/sets/.image" apt-get install -y locales
    run_in_container1 "$JINX_CACHE_DIR/sets/.image" locale-gen

    # Fix permissions of files
    find "$JINX_CACHE_DIR/sets/.image" -perm 000 -exec chmod 755 {} + 2>/dev/null

    run_in_container1 "$JINX_CACHE_DIR/sets/.image" apt-get install -y bash bzip2 curl diffutils findutils gawk git grep gzip lzip patch sed tar xz-utils zstd ${JINX_BASE_PACKAGES}

    if [[ -n ${JINX_CMAKE_PLATFORM} ]]; then
        cp "${base_dir}/${JINX_CMAKE_PLATFORM}" "${JINX_CACHE_DIR}"/sets/.image/usr/share/cmake-*/Modules/Platform/
    fi
}

first_use() {
    echo "* preparing Jinx cache..."

    mkdir -p "$JINX_CACHE_DIR"

    reinit_container

    echo "${jinx_version}" >"${JINX_CACHE_DIR}/version"
    echo "${JINX_DEBIAN_SNAPSHOT}" >"${JINX_CACHE_DIR}/debian_snapshot"
    echo "${JINX_BASE_PACKAGES}" >"${JINX_CACHE_DIR}/base_packages"

    echo "* done"
}

redo_first_use() {
    echo "* purging old Jinx cache..."
    force_remove "$JINX_CACHE_DIR"
    first_use
}

if [[ ! -f $JINX_CONFIG_FILE ]]; then
    die "$0: missing Jinxfile in directory '$base_dir'"
fi

unset JINX_MAJOR_VER
unset JINX_DEBIAN_SNAPSHOT
unset JINX_BASE_PACKAGES
unset JINX_CMAKE_PLATFORM
unset JINX_REPO_URL
. "${JINX_CONFIG_FILE}"

if [[ -z ${JINX_MAJOR_VER-} ]]; then
    die "$0: required Jinxfile variable JINX_MAJOR_VER missing"
fi

if [[ ${JINX_MAJOR_VER} != "${jinx_major_ver}" ]]; then
    die "$0: needed major version (${JINX_MAJOR_VER}) differs from Jinx-provided major version (${jinx_major_ver})"
fi

if [[ -z ${JINX_DEBIAN_SNAPSHOT-} ]]; then
    die "$0: required Jinxfile variable JINX_DEBIAN_SNAPSHOT missing"
fi

if [[ -z ${JINX_ARCH-} ]]; then
    die "$0: required config variable \$JINX_ARCH missing"
fi

if [[ ! -d $JINX_CACHE_DIR ]]; then
    first_use
fi

if  [[ ! -f "${JINX_CACHE_DIR}/version" || $(cat "${JINX_CACHE_DIR}/version") != "${jinx_version}" ]] \
 || [[ ! -f "${JINX_CACHE_DIR}/debian_snapshot" || $(cat "${JINX_CACHE_DIR}/debian_snapshot") != "${JINX_DEBIAN_SNAPSHOT}" ]] \
 || [[ ! -f "${JINX_CACHE_DIR}/base_packages" || $(cat "${JINX_CACHE_DIR}/base_packages") != "${JINX_BASE_PACKAGES-}" ]]; then
    redo_first_use
fi

case "$1" in
    internal-prepare)
        do_prepare "$2" "$3"
        ;;
    internal-fetch)
        do_fetch "$2" "$3"
        ;;
    internal-patch)
        do_patch "$2" "$3"
        ;;
    internal-configure-host)
        do_configure_host "$2"
        ;;
    internal-build-host)
        do_build_host "$2"
        ;;
    internal-package-host)
        do_package_host "$2"
        ;;
    internal-configure)
        do_configure "$2"
        ;;
    internal-build)
        do_build "$2"
        ;;
    internal-package)
        do_package "$2"
        ;;
    internal-run-in)
        shift 1
        do_run_in "$@"
        ;;
    build)
        shift 1
        cmd_build "$@"
        ;;
    update)
        shift 1
        cmd_update "$@"
        ;;
    regenerate|regen)
        shift 1
        cmd_regen "$@"
        ;;
    rebuild)
        shift 1
        cmd_rebuild "$@"
        ;;
    install)
        shift 1
        cmd_install "$@"
        ;;
