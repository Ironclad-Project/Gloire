diff --git libgtop-workdir/sysdeps/ironclad/procstate.c libgtop-workdir/sysdeps/ironclad/procstate.c
new file mode 100644
index 0000000..79f8e02
--- /dev/null
+++ libgtop-workdir/sysdeps/ironclad/procstate.c
@@ -0,0 +1,96 @@
+/* Ironclad sysdeps for LibGTop.
+
+   Written for Gloire.  LibGTop is free software; you can redistribute it
+   and/or modify it under the terms of the GNU General Public License as
+   published by the Free Software Foundation; either version 2 of the
+   License, or (at your option) any later version.
+
+   LibGTop is distributed in the hope that it will be useful, but WITHOUT
+   ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+   FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+   for more details.
+*/
+
+#include <config.h>
+#include <glibtop.h>
+#include <glibtop/procstate.h>
+#include <glibtop/procio.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "ironclad_private.h"
+
+static const unsigned long _glibtop_sysdeps_proc_state =
+(1L << GLIBTOP_PROC_STATE_CMD) + (1L << GLIBTOP_PROC_STATE_STATE) +
+(1L << GLIBTOP_PROC_STATE_UID) + (1L << GLIBTOP_PROC_STATE_RUID);
+
+void
+_glibtop_init_proc_state_s (glibtop *server)
+{
+	server->sysdeps.proc_state = _glibtop_sysdeps_proc_state;
+}
+
+void
+glibtop_get_proc_state_s (glibtop *server, glibtop_proc_state *buf, pid_t pid)
+{
+	struct ironclad_procinfo *procs;
+	unsigned long count, i;
+
+	memset (buf, 0, sizeof (glibtop_proc_state));
+
+	procs = _glibtop_ironclad_proclist (&count);
+	if (procs == NULL)
+		return;
+
+	for (i = 0; i < count; i++) {
+		size_t len;
+
+		if (procs [i].pid != (uint16_t) pid)
+			continue;
+
+		len = procs [i].id_len;
+		if (len >= sizeof (procs [i].id))
+			len = sizeof (procs [i].id);
+		if (len >= sizeof (buf->cmd))
+			len = sizeof (buf->cmd) - 1;
+		memcpy (buf->cmd, procs [i].id, len);
+		buf->cmd [len] = 0;
+
+		/* Ironclad exposes only "traced" and "exited", so a finer
+		   state would be invented rather than reported.  */
+		buf->state = (procs [i].flags & IRONCLAD_PROC_EXITED)
+			      ? GLIBTOP_PROCESS_ZOMBIE
+			      : GLIBTOP_PROCESS_RUNNING;
+
+		buf->uid  = (int) procs [i].uid;
+		buf->ruid = (int) procs [i].uid;
+
+		/* GID is deliberately NOT flagged: the kernel does not report
+		   it, and #4's own warning on this struct is that the flag
+		   must only be set when the value is correct.  */
+		buf->flags = _glibtop_sysdeps_proc_state;
+		break;
+	}
+
+	free (procs);
+}
+
+/* Ironclad keeps no per-process I/O accounting, and this SOURCES list has no
+   procio.c of its own, so the two entry points live here -- where the stub
+   directory's patched copy used to put them.  Flags stay zero: reporting zero
+   bytes read and written WITH the flags set would be a claim, not an absence.  */
+
+static const unsigned long _glibtop_sysdeps_proc_io = 0;
+
+void
+_glibtop_init_proc_io_s (glibtop *server)
+{
+	server->sysdeps.proc_io = _glibtop_sysdeps_proc_io;
+}
+
+void
+glibtop_get_proc_io_s (glibtop *server, glibtop_proc_io *buf, pid_t pid)
+{
+	memset (buf, 0, sizeof (glibtop_proc_io));
+}
diff --git libgtop-workdir/sysdeps/ironclad/proctime.c libgtop-workdir/sysdeps/ironclad/proctime.c
new file mode 100644
index 0000000..ecfa8dc
--- /dev/null
+++ libgtop-workdir/sysdeps/ironclad/proctime.c
@@ -0,0 +1,70 @@
+/* Ironclad sysdeps for LibGTop.
+
+   Written for Gloire.  LibGTop is free software; you can redistribute it
+   and/or modify it under the terms of the GNU General Public License as
+   published by the Free Software Foundation; either version 2 of the
+   License, or (at your option) any later version.
+
+   LibGTop is distributed in the hope that it will be useful, but WITHOUT
+   ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+   FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+   for more details.
+*/
+
+#include <config.h>
+#include <glibtop.h>
+#include <glibtop/proctime.h>
+
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "ironclad_private.h"
+
+static const unsigned long _glibtop_sysdeps_proc_time =
+(1L << GLIBTOP_PROC_TIME_START_TIME) + (1L << GLIBTOP_PROC_TIME_RTIME) +
+(1L << GLIBTOP_PROC_TIME_FREQUENCY);
+
+void
+_glibtop_init_proc_time_s (glibtop *server)
+{
+	server->sysdeps.proc_time = _glibtop_sysdeps_proc_time;
+}
+
+/* Ironclad reports ELAPSED WALL TIME per process and no CPU accounting, so
+   rtime is real and utime/stime are not reported at all.  Setting them to
+   zero WITH their flags would tell a system monitor that every process has
+   used no CPU, which is worse than telling it nothing.  */
+void
+glibtop_get_proc_time_s (glibtop *server, glibtop_proc_time *buf, pid_t pid)
+{
+	struct ironclad_procinfo *procs;
+	unsigned long count, i;
+	struct timespec now;
+
+	memset (buf, 0, sizeof (glibtop_proc_time));
+
+	procs = _glibtop_ironclad_proclist (&count);
+	if (procs == NULL)
+		return;
+
+	for (i = 0; i < count; i++) {
+		if (procs [i].pid != (uint16_t) pid)
+			continue;
+
+		buf->frequency  = 1000000000UL;         /* rtime is in nanoseconds */
+		buf->rtime      = (guint64) procs [i].elapsed.tv_sec * 1000000000UL
+				  + (guint64) procs [i].elapsed.tv_nsec;
+		buf->flags      = (1L << GLIBTOP_PROC_TIME_RTIME) |
+				  (1L << GLIBTOP_PROC_TIME_FREQUENCY);
+
+		if (clock_gettime (CLOCK_REALTIME, &now) == 0 &&
+		    now.tv_sec >= procs [i].elapsed.tv_sec) {
+			buf->start_time = (guint64) (now.tv_sec - procs [i].elapsed.tv_sec);
+			buf->flags |= (1L << GLIBTOP_PROC_TIME_START_TIME);
+		}
+		break;
+	}
+
+	free (procs);
+}
diff --git libgtop-workdir/sysdeps/ironclad/procuid.c libgtop-workdir/sysdeps/ironclad/procuid.c
new file mode 100644
index 0000000..64e0ad8
--- /dev/null
+++ libgtop-workdir/sysdeps/ironclad/procuid.c
@@ -0,0 +1,86 @@
+/* Ironclad sysdeps for LibGTop.
+
+   Written for Gloire.  LibGTop is free software; you can redistribute it
+   and/or modify it under the terms of the GNU General Public License as
+   published by the Free Software Foundation; either version 2 of the
+   License, or (at your option) any later version.
+
+   LibGTop is distributed in the hope that it will be useful, but WITHOUT
+   ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+   FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+   for more details.
+*/
+
+#include <config.h>
+#include <glibtop.h>
+#include <glibtop/procuid.h>
+
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <sched.h>
+#include <sys/resource.h>
+
+#include "ironclad_private.h"
+
+static const unsigned long _glibtop_sysdeps_proc_uid =
+(1L << GLIBTOP_PROC_UID_UID) + (1L << GLIBTOP_PROC_UID_PID) +
+(1L << GLIBTOP_PROC_UID_PPID);
+
+static const unsigned long _glibtop_sysdeps_proc_uid_nice =
+(1L << GLIBTOP_PROC_UID_NICE);
+
+static const unsigned long _glibtop_sysdeps_proc_uid_priority =
+(1L << GLIBTOP_PROC_UID_PRIORITY);
+
+void
+_glibtop_init_proc_uid_s (glibtop *server)
+{
+	server->sysdeps.proc_uid = _glibtop_sysdeps_proc_uid |
+		_glibtop_sysdeps_proc_uid_nice |
+		_glibtop_sysdeps_proc_uid_priority;
+}
+
+void
+glibtop_get_proc_uid_s (glibtop *server, glibtop_proc_uid *buf, pid_t pid)
+{
+	struct ironclad_procinfo *procs;
+	unsigned long count, i;
+
+	memset (buf, 0, sizeof (glibtop_proc_uid));
+
+	procs = _glibtop_ironclad_proclist (&count);
+	if (procs == NULL)
+		return;
+
+	for (i = 0; i < count; i++) {
+		struct sched_param param;
+		int nice;
+
+		if (procs [i].pid != (uint16_t) pid)
+			continue;
+
+		buf->uid   = (gint32) procs [i].uid;
+		buf->pid   = (gint32) procs [i].pid;
+		buf->ppid  = (gint32) procs [i].ppid;
+		buf->flags = _glibtop_sysdeps_proc_uid;
+
+		/* getpriority() legitimately returns -1, so errno decides --
+		   the same care util-ironclad's ps.c takes.  */
+		errno = 0;
+		nice = getpriority (PRIO_PROCESS, (id_t) pid);
+		if (!(nice == -1 && errno != 0)) {
+			buf->nice   = nice;
+			buf->flags |= _glibtop_sysdeps_proc_uid_nice;
+		}
+
+		memset (&param, 0, sizeof (param));
+		if (sched_getparam (pid, &param) == 0) {
+			buf->priority = param.sched_priority;
+			buf->flags   |= _glibtop_sysdeps_proc_uid_priority;
+		}
+		break;
+	}
+
+	free (procs);
+}
