+   Written for Gloire.  LibGTop is free software; you can redistribute it
+   and/or modify it under the terms of the GNU General Public License as
+   published by the Free Software Foundation; either version 2 of the
+   License, or (at your option) any later version.
+
+   LibGTop is distributed in the hope that it will be useful, but WITHOUT
+   ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+   FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+   for more details.
+*/
+
+#include <config.h>
+#include <glibtop.h>
+#include <glibtop/sysinfo.h>
+
+#include <stdio.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#include "ironclad_private.h"
+
+static glibtop_sysinfo sysinfo = { .flags = 0 };
+
+static void
+add (glibtop_entry *e, const char *key, char *value)
+{
+	char *k = g_strdup (key);
+
+	g_ptr_array_add (e->labels, k);
+	g_hash_table_insert (e->values, k, value);
+}
+
+/* Ironclad's cpuinfo describes the MACHINE rather than each core, so every
+   entry carries the same model, vendor and clocks.  That is what the kernel
+   knows; inventing per-core differences would be worse.  */
+static void
+init_sysinfo (void)
+{
+	struct ironclad_cpuinfo cpu;
+	char name [sizeof (cpu.model_name) + 1];
+	char vendor [sizeof (cpu.vendor_name) + 1];
+	guint64 i;
+
+	if (sysinfo.flags) return;
+
+	if (syscall (SYS_getcpuinfo, &cpu) != 0)
+		return;
+
+	memcpy (name, cpu.model_name, sizeof (cpu.model_name));
+	name [sizeof (cpu.model_name)] = 0;
+	memcpy (vendor, cpu.vendor_name, sizeof (cpu.vendor_name));
+	vendor [sizeof (cpu.vendor_name)] = 0;
+
+	sysinfo.ncpu = cpu.onln_cores;
+	if (sysinfo.ncpu > GLIBTOP_NCPU)
+		sysinfo.ncpu = GLIBTOP_NCPU;
+
+	for (i = 0; i < sysinfo.ncpu; i++) {
+		glibtop_entry * const e = &sysinfo.cpuinfo [i];
+
+		e->labels = g_ptr_array_new ();
+		e->values = g_hash_table_new_full (g_str_hash, g_str_equal,
+						   g_free, g_free);
+		e->descriptions = g_hash_table_new_full (g_str_hash, g_str_equal,
+							 NULL, g_free);
+
+		add (e, "processor", g_strdup_printf ("%" G_GUINT64_FORMAT, i));
+		if (name [0])   add (e, "model name", g_strdup (name));
+		if (vendor [0]) add (e, "vendor_id",  g_strdup (vendor));
+		if (cpu.base_mhz)
+			add (e, "cpu MHz", g_strdup_printf ("%u", cpu.base_mhz));
+	}
+
+	sysinfo.flags = (1L << GLIBTOP_SYSINFO_NCPU) |
+			(1L << GLIBTOP_SYSINFO_CPUINFO);
+}
+
+const glibtop_sysinfo *
+glibtop_get_sysinfo_s (glibtop *server)
+{
+	init_sysinfo ();
+	return &sysinfo;
+}
