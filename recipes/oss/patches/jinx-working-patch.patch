diff --git oss-workdir/kernel/OS/Ironclad/os_ironclad.h oss-workdir/kernel/OS/Ironclad/os_ironclad.h
new file mode 100644
index 0000000..60226c9
--- /dev/null
+++ oss-workdir/kernel/OS/Ironclad/os_ironclad.h
@@ -0,0 +1,217 @@
+#ifndef _OS_H_
+#define _OS_H_
+
+/*
+ * Purpose: OS specific definitions for Ironclad
+ *
+ * Ironclad currently has no in-kernel OSS implementation: this port covers
+ * the user land libraries and utilities only.  Everything below that the
+ * user land side of OSS needs (integer types, the ioctl encoding, the
+ * "struct fileinfo" / oss_device_t shapes referenced by oss_config.h) is
+ * defined for real.  The kernel-only entry points are declared, but nothing
+ * implements them yet - a future kernel port supplies kernel/OS/Ironclad/
+ * os_ironclad.c and a driver glue layer, at which point only the _KERNEL
+ * half of this file needs revisiting.
+ *
+ * Utilities that talk to a device (ossinfo, ossmix, ossplay, ...) therefore
+ * build and run, but fail at open()/devctl() time with ENOENT/ENOTTY
+ * because no /dev/mixer* or /dev/dsp* node exists.  That is the intended
+ * behaviour for now; the tools all degrade gracefully.
+ */
+/*
+ *
+ * This file is part of Open Sound System.
+ *
+ * Copyright (C) 4Front Technologies 1996-2008.
+ *
+ * This this source file is released under GPL v2 license (no other versions).
+ * See the COPYING file included in the main directory of this source
+ * distribution for the license terms and conditions.
+ *
+ */
+
+#define OS_VERSION		"0.0"
+#define __EXTENDED__
+#define OSS_MAINLINE_BUILD
+
+/*
+ * Debugging and misc settings
+ */
+#undef  MUTEX_CHECKS
+#undef  MEMDEBUG
+#undef  DO_TIMINGS
+
+/*
+ * No kernel side yet, so there is nothing that could create the /dev/dsp
+ * "virtual device" nodes or do per-application device routing.
+ */
+#undef  VDEV_SUPPORT
+#undef  APPLIST_SUPPORT
+#undef  MANAGE_DEV_DSP
+
+/* ossdevlinks creates /dev/oss/<card>/<dev> style subdirectories */
+#define USE_DEVICE_SUBDIRS
+
+#define EXTERN_C
+
+/* Dummy define to cure some broken ioctl.h versions */
+#define __invalid_size_argument_for_IOC 0
+
+#include <sys/types.h>
+#include <sys/param.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <poll.h>
+
+#include <oss_errno.h>
+#include "oss_ddi.h"
+
+/* The soundcard.h could be in a nonstandard place so include it here. */
+#include "soundcard.h"
+
+#undef HZ
+extern int oss_hz;
+#define OSS_HZ oss_hz
+
+/*
+ * Integer types.  Ironclad is LP64 on both of the architectures Gloire
+ * targets (x86_64 and riscv64), and ILP32 is not supported at all, but keep
+ * the definitions derived from the compiler rather than hard coded.
+ */
+typedef unsigned long oss_native_word;	/* Same size as an address */
+typedef long long oss_int64_t;			/* Signed 64 bit integer */
+typedef unsigned long long oss_uint64_t;	/* Unsigned 64 bit integer */
+
+/*
+ * Locking and sleep/poll primitives.  Opaque to everything outside the
+ * (not yet written) kernel glue.
+ */
+typedef struct _oss_mutex_t *oss_mutex_t;
+typedef struct _poll_table_handle oss_poll_table_handle_t;
+typedef struct _file_handle_t oss_file_handle_t;
+
+struct _oss_poll_event_t
+{
+  short events, revents;
+  oss_poll_table_handle_t *wait;
+  oss_file_handle_t *file;
+};
+typedef struct _oss_poll_event_t oss_poll_event_t;
+
+struct oss_wait_queue;
+struct module;
+struct _oss_device_t;
+
+typedef void *oss_dma_handle_t;		/* Unused type */
+typedef struct _dev_info_t dev_info_t;
+
+/*
+ * Per open file information.  Filled in by the kernel side when a device
+ * file is opened.
+ */
+struct fileinfo
+{
+  int mode;			/* Open mode */
+  int acc_flags;
+};
+#define ISSET_FILE_FLAG(fileinfo, flag)  (fileinfo->acc_flags & (flag) ? 1:0)
+
+struct _oss_device_t
+{
+  int cardnum;
+  int dev_type;
+  int available;
+  int instance;
+  dev_info_t *dip;
+  void *devc;
+  char *name;
+  char nick[16];
+  char handle[32];
+  int num_audio_engines;
+  int num_audioplay, num_audiorec, num_audioduplex;
+  int num_mididevs;
+  int num_mixerdevs;
+  int num_loopdevs;
+  int first_mixer;	/* This must be set to -1 by osdev_create() */
+  int major;
+  struct module *owner;
+  char modname[32];
+  char *hw_info;
+
+  volatile int refcount;	/* Nonzero means that the device is needed
+				   by some other (virtual) driver. */
+
+/* Interrupts */
+  ddi_iblock_cookie_t iblock_cookie;	/* Dummy field under Ironclad */
+  void *irqparms;
+  int intrcount, ackcount;
+};
+
+#define ALLOW_BUFFER_MAPPING
+#define ALLOW_SELECT
+#define SEL_IN		0
+#define SEL_OUT		1
+#define SEL_EX		0xffffffff
+
+/* Busy wait routine */
+extern void oss_udelay (unsigned long d);
+#define drv_usecwait oss_udelay
+
+/* System wall timer access */
+extern unsigned long long oss_get_jiffies (void);
+#define GET_JIFFIES()	oss_get_jiffies()
+
+extern void oss_cmn_err (int level, char *format, ...);
+#define CE_CONT		0
+#define CE_NOTE		1
+#define CE_WARN		2
+#define CE_PANIC	3
+#define cmn_err oss_cmn_err
+
+#ifdef _KERNEL
+/*
+ * Everything below this point is only meaningful once somebody writes the
+ * Ironclad kernel side of OSS.  None of it is referenced by the user land
+ * build, and none of it is implemented anywhere yet.
+ */
+
+#if defined(__i386__) || defined(__x86_64__)
+extern unsigned int __inb (unsigned short port);
+extern unsigned int __inw (unsigned short port);
+extern unsigned int __inl (unsigned short port);
+extern void __outb (unsigned char value, unsigned short port);
+extern void __outw (unsigned short value, unsigned short port);
+extern void __outl (unsigned int value, unsigned short port);
+
+#define INB(osdev, a)		__inb(a)
+#define INW(osdev, a)		__inw(a)
+#define INL(osdev, a)		__inl(a)
+#define OUTB(osdev, d, a)	__outb(d, a)
+#define OUTW(osdev, d, a)	__outw(d, a)
+#define OUTL(osdev, d, a)	__outl(d, a)
+#endif
+
+extern oss_mutex_t oss_mutex_init (void);
+extern void oss_mutex_cleanup (oss_mutex_t mutex);
+extern void oss_spin_lock_irqsave (oss_mutex_t mutex, oss_native_word * flags);
+extern void oss_spin_unlock_irqrestore (oss_mutex_t mutex,
+					oss_native_word flags);
+extern void oss_spin_lock (oss_mutex_t mutex);
+extern void oss_spin_unlock (oss_mutex_t mutex);
+
+extern char *oss_get_procname (void);
+extern int oss_get_pid (void);
+extern unsigned int oss_get_uid (void);
+
+extern void *oss_contig_malloc (struct _oss_device_t * osdev, int sz,
+				oss_uint64_t memlimit,
+				oss_native_word * phaddr);
+extern void oss_contig_free (struct _oss_device_t * osdev, void *p, int sz);
+extern oss_native_word oss_virt_to_bus (void *addr);
+
+extern int oss_init_osscore (struct _oss_device_t * osdev);
+extern void oss_uninit_osscore (struct _oss_device_t * osdev);
+#endif /* _KERNEL */
+
+#endif /* _OS_H_ */
