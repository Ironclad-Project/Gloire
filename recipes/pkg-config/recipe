#! /bin/sh

repology_id=pkgconf
version=3.0.10
revision=1
tarball_url="https://distfiles.ariadne.space/pkgconf/pkgconf-${version}.tar.xz"
tarball_blake2b="0af6b2816326e666705301e29443c6d76a9ce7720e44a70cf08d71d540dfbe89293b3e55ff2bb3b31736d47a1a4e97cdd8c7653e49f26a81d9d8dfe15a962f2d"
hostdeps="gcc pkg-config"
deps="core-libs"

configure() {
    meson_configure
}

build() {
    meson compile --verbose -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    ln -s pkgconf "${dest_dir}${prefix}"/bin/pkg-config
    ln -s pkgconf.1 "${dest_dir}${prefix}"/share/man/man1/pkg-config.1

    post_package_strip
}
