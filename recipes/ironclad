#! /bin/sh

name=ironclad
skip_pkg_check=yes
version=0.0git
revision=54
git_url="https://codeberg.org/Ironclad/Ironclad.git"
commit=dccc57df4c4063ad977078921a3f7f8787a15e1c
source_hostdeps="autoconf automake pkg-config"
imagedeps="gprbuild"
hostdeps="gcc pkg-config"
deps="core-libs"

early_prepare() {
    ./bootstrap
}

prepare() {
    autotools_recursive_regen
}

configure() {
    autotools_configure_noflags
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install
}
