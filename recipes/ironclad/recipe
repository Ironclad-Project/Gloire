#! /bin/sh

skip_pkg_check=yes
version=0.0git
revision=75
git_url="https://codeberg.org/Ironclad/Ironclad.git"
commit=ccb16b390461501ee5b55bc1a2a94c02e52e295f
source_imagedeps="autoconf automake pkg-config"
imagedeps="gprbuild"
hostdeps="gcc pkg-config"
deps="core-libs texinfo"

early_prepare() {
    ./bootstrap
}

prepare() {
    autotools_recursive_regen
}

configure() {
    autotools_configure_noflags
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    generate_info_hooks
}
