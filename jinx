set -e
set -u

# Optional environment variables - initialise to empty so set -u is satisfied
# regardless of whether the user/parent shell set them.
: "${JINX_PARALLELISM:=}"
: "${JINX_CACHE_DIR:=}"
: "${JINX_NATIVE_MODE:=}"
: "${JINX_NATIVE_LANG:=}"
: "${JINX_CLEAN_WORKDIRS:=}"
: "${TERM:=}"
: "${COLORTERM:=}"
: "${LD_LIBRARY_PATH:=}"

IFS=$' \t\n'

export LC_COLLATE=C

umask 0022

jinx_major_ver="0.9"
jinx_minor_ver="0"

jinx_version="${jinx_major_ver}.${jinx_minor_ver}"

XBPS_VERSION=0.60.7
XBPS_SHA256SUM=ec8c2e4d595863b5748c10d9ada1d51ac1da6f910a9d31682acd1a477310c64e

debootstrap_version=1.0.143
debootstrap_sha256sum=15652a91eb1cf04c24c485bbaaf36e0528132bded8475820344a8129c7eaca01

die() {
    echo "$1" 1>&2
    exit 1
}

if [[ -z ${1-} ]]; then
    die "$0: no command specified."
fi

cmd_help() {
    echo "usage: $0 <command> [args...]"
    printf "\n   help|--help        Displays this message"
    printf "\n   version|--version  Prints the version"
    printf "\n   init               Initialises a build directory"
    printf "\n   update             Rebuild outdated package(s); use '-b' to also build never-built ones"
    printf "\n   build              Builds package(s), does incremental builds"
    printf "\n   rebuild            Rebuilds package(s)"
    printf "\n   regenerate|regen   Regenerates patch for package(s) and re-runs prepare step"
    printf "\n   install            Installs package(s) (use '-f' to reinstall)"
    printf "\n   dry-run            Prints all packages that need to be built in order (space separated)"
    printf "\n   download           Downloads pre-built package(s) from remote repo"
    printf "\n   run-in             Runs a command in a container prepared with a recipe's hostdeps"
    printf "\n   rebuild-cache      Rebuilds Jinx cache"
    printf "\n\nexample: $0 update '*'\n"
}

cmd_init() {
    if [[ ! -f "$1/Jinxfile" ]]; then
        die "$0: Provided source directory contains no Jinxfile"
    fi

    local srcdir="$1"

    if [[ -f .jinx-parameters ]]; then
        die "$0: Current directory already initialised, run '$0 deinit' first"
    fi

    if [[ -f Jinxfile ]]; then
        die "$0: In-tree builds are not supported"
    fi

    cat <<EOF >.jinx-parameters
#! /bin/sh

JINX_SOURCE_DIR="${srcdir}"
JINX_ARCH="$(uname -m)"
EOF

    shift 1

    local p
    for p in "$@"; do
        printf 'JINX_%s="%s"\n' "${p%%=*}" "${p#*=}" >>.jinx-parameters
    done

    echo "Initialised with '${srcdir}' as source directory"
}

case "$1" in
    version|--version)
        echo "Jinx version $jinx_version"
        exit 0
        ;;
    help|--help)
        cmd_help
        exit 0
        ;;
    init)
        shift 1
        cmd_init "$@"
        exit 0
        ;;
esac

if [[ $(uname -s) != Linux ]]; then
    die "$0: Jinx only supports running on Linux hosts."
fi

script_name="$(basename "$0")"
script_dir="$(dirname "$0")"
if [[ $script_dir == . || -z $script_dir ]]; then
    if [[ $0 == */* ]]; then
        script_dir=.
    else
        script_dir="$(dirname "$(which "${script_name}")")"
    fi
fi
script_dir="$(cd "${script_dir}" && pwd -P)"
script="${script_dir}/${script_name}"

in_container=false
if [[ $script == //jinx ]]; then
    in_container=true
fi

case "$1" in
    install)
        ;;
    *)
        if [[ ${in_container} == false && $(id -u) == 0 ]]; then
            die "$0: Jinx does not support running as root."
        fi
        ;;
esac

if [[ -z ${JINX_PARALLELISM} ]]; then
    max_threads_by_mem=$(( ((($(free | awk '/^Mem:/{print $2}') + 1048575) / 1048576) + 1) / 2 ))
    parallelism="$(nproc 2>/dev/null || echo 1)"
    parallelism=$(( parallelism < max_threads_by_mem ? parallelism : max_threads_by_mem ))
else
    parallelism="$JINX_PARALLELISM"
fi

if [[ ${in_container} == false ]]; then
    build_dir="$(pwd -P)"
else
    build_dir=/build_dir
fi

if [[ ! -f "${build_dir}/.jinx-parameters" ]]; then
    die "$0: Please run '$0 init <source dir> <parameters>' first"
fi

. "${build_dir}"/.jinx-parameters

if [[ ${in_container} == false ]]; then
    base_dir="$(cd "$JINX_SOURCE_DIR" && pwd -P)"
else
    base_dir=/base_dir
fi

JINX_CONFIG_FILE="${base_dir}/Jinxfile"

if [[ ! -d "$(dirname "$JINX_CONFIG_FILE")" ]]; then
    die "$0: cannot access Jinxfile directory"
fi
JINX_CONFIG_FILE="$(cd "$(dirname "$JINX_CONFIG_FILE")" && pwd -P)"/"$(basename "$JINX_CONFIG_FILE")"

if [[ -z ${JINX_CACHE_DIR} ]]; then
    JINX_CACHE_DIR="${base_dir}/.jinx-cache"
fi
if [[ ! -d "$(dirname "$JINX_CACHE_DIR")" ]]; then
    die "$0: cannot access cache directory parent"
fi

if [[ ${in_container} == false ]]; then
    mkdir -p "$JINX_CACHE_DIR"
    JINX_CACHE_DIR="$(cd "$JINX_CACHE_DIR" && pwd -P)"

    export PATH="${JINX_CACHE_DIR}/xbps/bin:${JINX_CACHE_DIR}/debootstrap/usr/sbin:${PATH}:/usr/sbin:/sbin"
    if [[ -n ${LD_LIBRARY_PATH} ]]; then
        LD_LIBRARY_PATH=":${LD_LIBRARY_PATH}"
    fi
    export LD_LIBRARY_PATH="${JINX_CACHE_DIR}/xbps/lib${LD_LIBRARY_PATH}"

    mkdir -p "${base_dir}/sources" "${base_dir}/host-sources" "${build_dir}/host-builds" "${build_dir}/host-pkgs" "${build_dir}/builds" "${build_dir}/pkgs"
fi

apt_cache="$JINX_CACHE_DIR/apt-cache"

force_remove() {
    chmod -R 777 "$@" 2>/dev/null || true
    rm -rf "$@"
}

temp_collect=()

cleanup_done=no
cleanup() {
    if [[ ${cleanup_done} == yes ]]; then
        return
    fi
    cleanup_done=yes
    if (( ${#temp_collect[@]} > 0 )); then
        force_remove "${temp_collect[@]}"
    fi
}

trap 'tmp_ret=$?; set +e; cleanup; trap - EXIT; exit ${tmp_ret}' INT TERM HUP QUIT EXIT

make_temp() {
    tmp="$(mktemp ${1-} "$JINX_CACHE_DIR/tmp/tmp.XXXXXXXX")"
    temp_collect+=("${tmp}")
}

tracked_subshell() {
    (
        temp_collect=()
        cleanup_done=no
        trap 'tmp_ret=$?; set +e; cleanup; trap - EXIT; exit ${tmp_ret}' INT TERM HUP QUIT EXIT
        set -e
        eval "$1"
    )
}

include_recipe() {
    if [[ ! -f $1/recipe ]]; then
        printf 'die %q\n' "$0: recipe file '$1/recipe' not found"
        return 1
    fi
    cat <<'EOF'
local cross_compile=
local version=
local revision=
local from_source=
local from_host_source=
local deps=
local builddeps=
local hostdeps=
local hostrundeps=
local imagedeps=
local allow_network=
local source_deps=
local source_hostdeps=
local source_imagedeps=
local source_allow_network=
local clean_workdirs=
local bootstrap_pkg=
local source_dir=
local git_url=
local commit=
local shallow=
local tarball_url=
local tarball_sha256=
local tarball_sha512=
local tarball_blake2b=

early_prepare() { :; }
prepare() { :; }
configure() { :; }
build() { :; }
package() { :; }
EOF
    printf 'local recipe_dir=%q\n' "$1"
    printf 'local name=%q\n' "$(basename "$1")"
    printf 'local _expected_name=%q\n' "$(basename "$1")"
    printf '. %q/recipe\n' "$1"
    cat <<'EOF'

if [[ ${name} != ${_expected_name} ]]; then
    die "$0: recipe at '${recipe_dir}' must not override 'name' (recipe sets '${name}' but directory is '${_expected_name}'); remove the 'name=' assignment from the recipe"
fi

case "${recipe_dir}" in
    */host-recipes/*) local _from_source_dir=host-recipes ;;
    *) local _from_source_dir=recipes ;;
esac
if [[ -n ${from_host_source} ]]; then
    if [[ -n ${from_source} ]]; then
        die "$0: recipe '${name}' sets both from_source and from_host_source"
    fi
    local from_source=${from_host_source}
    local _from_source_dir=host-recipes
elif [[ -n ${from_source} ]]; then
    local _from_source_dir=recipes
fi
local _sources_root=${_from_source_dir/recipes/sources}

if [[ -n ${from_source} && -d ${recipe_dir}/patches ]]; then
    die "$0: recipe '${name}' uses from_source/from_host_source and cannot have its own patches/ directory (patches live with the source recipe)"
fi
EOF
}

build_hostdeps() {
    local hostdep
    for hostdep in ${hostdeps} ${hostrundeps}; do
        [[ -f "${base_dir}/host-recipes/${hostdep}/recipe" ]] || die "missing host dependency '${hostdep}' for recipe '${name}'"

        tracked_subshell '
            do_host_build_if_needed ${hostdep}
        '
    done
}

build_deps() {
    local dep
    for dep in ${deps} ${builddeps}; do
        [[ -f "${base_dir}/recipes/${dep}/recipe" ]] || die "missing dependency '${dep}' for recipe '${name}'"

        tracked_subshell '
            do_update yes ${dep}
        '
    done
}

get_hostdeps_file() {
    local deps_to_do=""

    local hostdep
    for hostdep in ${hostdeps} ${hostrundeps}; do
        if [[ -z ${_hostdeps_collected[$hostdep]+x} ]]; then
            local deps_to_do="${deps_to_do} ${hostdep}"
            _hostdeps_collected[$hostdep]=1
        fi
    done

    for hostdep in ${deps_to_do}; do
        eval "$(include_recipe "${base_dir}"/host-recipes/${hostdep})"
        get_hostdeps_file
    done
}

topo_sort_visit() {
    [[ -n ${_visited[$1]+x} ]] && return
    _visited[$1]=1

    local _dep
    for _dep in ${_graph[$1]}; do
        [[ -n $_dep ]] && topo_sort_visit "$_dep"
    done

    _result="${_result}$1 "
}

topo_sort() {
    local -A _graph
    local -A _visited
    local _result=

    local _node _deps
    while IFS=: read -r _node _deps; do
        [[ -z $_node ]] && continue
        # first occurrence wins (matches awk's previous exit-on-first-match)
        [[ -n ${_graph[$_node]+x} ]] || _graph[$_node]=$_deps
    done <<<"$1"

    for _node in $(printf '%s\n' "${!_graph[@]}" | sort); do
        topo_sort_visit "$_node"
    done

    echo "${_result% }"
}

get_builddeps() {
    local pkg="$1"

    eval "$(include_recipe "${base_dir}/recipes/${pkg}")"

    local -A _deps_collected

    get_builddeps_file

    local graph="${pkg}:${deps}"
    if [[ -n ${builddeps} ]]; then
        local graph="${graph} ${builddeps}"
        local graph="${graph//: /:}"
    fi

    local dep
    for dep in "${!_deps_collected[@]}"; do
        if [[ ! -f "${base_dir}/recipes/${dep}/recipe" ]]; then
            die "$0: dependency '${dep}' for recipe '${pkg}' not found"
        fi

        local graph="${graph}
${dep}:$(eval "$(include_recipe "${base_dir}/recipes/${dep}")" && echo ${deps})"
    done

    topo_sort "${graph}"
}

get_hostdeps_builddeps() {
    # Similar to get_builddeps, but for host recipes.
    # Builds a topological ordering of host recipe dependencies.
    local hostpkg="$1"

    eval "$(include_recipe "${base_dir}/host-recipes/${hostpkg}")"

    local -A _hostdeps_collected

    get_hostdeps_file_for_topo

    local graph="${hostpkg}:${hostdeps} ${hostrundeps}"
    if [[ -n ${hostdeps} || -n ${hostrundeps} ]]; then
        local graph="${graph//: /:}"
    fi

    local hostdep
    for hostdep in "${!_hostdeps_collected[@]}"; do
        if [[ ! -f "${base_dir}/host-recipes/${hostdep}/recipe" ]]; then
            die "$0: host dependency '${hostdep}' for host recipe '${hostpkg}' not found"
        fi

        local graph="${graph}
${hostdep}:$(eval "$(include_recipe "${base_dir}/host-recipes/${hostdep}")" && echo ${hostdeps} ${hostrundeps})"
    done

    topo_sort "${graph}"
}

get_hostdeps_file_for_topo() {
    # Collects all host dependencies recursively for use in topological sort.
    local deps_to_do=""

    local hostdep
    for hostdep in ${hostdeps} ${hostrundeps}; do
        if [[ -z ${_hostdeps_collected[$hostdep]+x} ]]; then
            local deps_to_do="${deps_to_do} ${hostdep}"
            _hostdeps_collected[$hostdep]=1
        fi
    done

    for hostdep in ${deps_to_do}; do
        eval "$(include_recipe "${base_dir}"/host-recipes/${hostdep})"
        get_hostdeps_file_for_topo
    done
}

get_builddeps_file() {
    local deps_to_do=""

    local dep
    for dep in ${deps} ${builddeps}; do
        if [[ -z ${_deps_collected[$dep]+x} ]]; then
            local deps_to_do="${deps_to_do} ${dep}"
            _deps_collected[$dep]=1
        fi
    done

    for dep in ${deps_to_do}; do
        eval "$(include_recipe "${base_dir}"/recipes/${dep})"
        get_deps_file
    done
}

get_deps_file() {
    local deps_to_do=""

    local dep
    for dep in ${deps}; do
        if [[ -z ${_deps_collected[$dep]+x} ]]; then
            local deps_to_do="${deps_to_do} ${dep}"
            _deps_collected[$dep]=1
        fi
    done

    for dep in ${deps_to_do}; do
        eval "$(include_recipe "${base_dir}"/recipes/${dep})"
        get_deps_file
    done
}

run_in_container1() {
    local run_in_cont1_root="$1"
    shift 1

    cat /etc/resolv.conf >"${run_in_cont1_root}/etc/resolv.conf"

    local arg
    unshare --user --map-root-user --mount --pid --fork -- sh -c "
        set -e

        mount --rbind --make-rslave /dev '${run_in_cont1_root}/dev'
        mount -t proc proc '${run_in_cont1_root}/proc'
        mount --rbind --make-rslave /sys '${run_in_cont1_root}/sys'
        mount -t tmpfs run '${run_in_cont1_root}/run'
        mount -t tmpfs tmpfs '${run_in_cont1_root}/tmp'
        mount -t tmpfs tmpfs '${run_in_cont1_root}/var/tmp'

        mount --bind '${apt_cache}' '${run_in_cont1_root}/var/cache/apt/archives'

        env -i PATH='${PATH}' chroot '${run_in_cont1_root}' /bin/sh -c '
            set -e

            LD_PRELOAD=/nochown.so \
            HOME=/root \
            LANG=en_US.UTF-8 \
            LC_COLLATE=C \
            PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin \
            LD_LIBRARY_PATH=/usr/local/lib64:/usr/local/lib:/usr/lib64:/usr/lib \
            DEBIAN_FRONTEND=noninteractive \
            $(for arg in "$@"; do printf '"%s" \\\n' "${arg//\"/\\\"}"; done)
            # keep this whitespace
        '
    "

    rm "${run_in_cont1_root}/etc/resolv.conf"
}

check_duplicates() {
    local elem
    for elem in $(cd "$1" && find .); do
        if [[ -f "$2/${elem}" || -L "$2/${elem}" ]]; then
            return 1
        fi
    done
}

prepare_container() {
    cd "${build_dir}"

    local -A _hostdeps_collected
    local -A _deps_collected

    build_hostdeps
    build_deps

    get_hostdeps_file
    get_builddeps_file

    make_temp -d
    container_pkgs="${tmp}"
    make_temp -d
    sysroot="${tmp}"

    make_temp
    local tmp_stdout="${tmp}"
    make_temp
    local tmp_stderr="${tmp}"
    local dep
    for dep in "${!_deps_collected[@]}"; do
        XBPS_ARCH=invalid \
        XBPS_TARGET_ARCH="${JINX_ARCH}" \
		xbps-install -y -r "${sysroot}" -R "${build_dir}"/pkgs "${dep}" >"${tmp_stdout}" 2>"${tmp_stderr}" \
	|| (echo "jinx: xbps-install failed! stdout:" && sed 's/^/\- /' "${tmp_stdout}" && echo jinx: stderr: && sed 's/^/\- /' "${tmp_stderr}" && exit 17)
    done

    if [[ $JINX_NATIVE_MODE == yes && -z $cross_compile ]]; then
        imgroot="${sysroot}"
    else
        local hostdep
        for hostdep in "${!_hostdeps_collected[@]}"; do
            if ! check_duplicates "${build_dir}/host-pkgs/${hostdep}/usr/local" "${container_pkgs}"; then
                die "jinx: error: Dependency '${hostdep}' contains file confilcts"
            fi
            cp -Pplr "${build_dir}/host-pkgs/${hostdep}/usr/local/." "${container_pkgs}/"
        done

        imagedeps="$(echo "${imagedeps}" | xargs -n1 | sort -u | xargs)"

        local pkgset=""
        local pkg
        for pkg in ${imagedeps}; do
            local pkgset="${pkgset}${pkg}/"

            if [[ -f "$JINX_CACHE_DIR/sets/${pkgset}.image/.jinx-set-valid" ]]; then
                continue
            fi

            force_remove "$JINX_CACHE_DIR/sets/${pkgset}"
            mkdir -p "$JINX_CACHE_DIR/sets/${pkgset}"

            cp -Pplrf "$JINX_CACHE_DIR/sets/${pkgset}../.image" "$JINX_CACHE_DIR/sets/${pkgset}.image"

            rm -f "$JINX_CACHE_DIR/sets/${pkgset}.image/.jinx-set-valid"

            run_in_container1 "$JINX_CACHE_DIR/sets/${pkgset}.image" apt-get install -y "${pkg}"

            # Fix permissions of files
            find "$JINX_CACHE_DIR/sets/${pkgset}.image" -perm 000 -exec chmod 755 {} + 2>/dev/null

            touch "$JINX_CACHE_DIR/sets/${pkgset}.image/.jinx-set-valid"
        done

        imgroot="$JINX_CACHE_DIR/sets/${pkgset}.image"
    fi
}

run_in_container() {
    if [[ ${allow_network} == yes ]]; then
        local unshare_net_flag=""
    else
        local unshare_net_flag="--net"
    fi

    local run_in_cont_term=
    if [[ -n $TERM ]]; then
        local run_in_cont_term="TERM=\"$TERM\""
    fi

    local run_in_cont_colorterm=
    if [[ -n $COLORTERM ]]; then
        local run_in_cont_colorterm="COLORTERM=\"$COLORTERM\""
    fi

    mkdir -p "${imgroot}/base_dir" "${imgroot}/sources" "${imgroot}/host-sources" "${imgroot}/build_dir"
    cat /etc/resolv.conf >"${imgroot}/etc/resolv.conf"
    touch "${imgroot}/jinx"

    local container_pkgs_native_mount=""
    local sysroot_native_mount=""
    if [[ ($JINX_NATIVE_MODE == yes && $cross_compile == yes) || $JINX_NATIVE_MODE != yes ]]; then
        mkdir -p "${imgroot}/sysroot"

        local container_pkgs_native_mount="mount -o ro --bind '${container_pkgs}' '${imgroot}/usr/local'"
        local sysroot_native_mount="mount -o ro --bind '${sysroot}' '${imgroot}/sysroot'"

        local run_in_cont_lang=en_US.UTF-8
    else
        if [[ -n $JINX_NATIVE_LANG ]]; then
            local run_in_cont_lang="$JINX_NATIVE_LANG"
        else
            local run_in_cont_lang=C
        fi
    fi

    local shadow_git_dir_build=""
    if [[ -d "${build_dir}/.git" ]]; then
        make_temp -d
        local shadow_git_dir_build="mount --bind '${tmp}' '${imgroot}/build_dir/.git'"
    fi

    local shadow_git_dir_base=""
    if [[ -d "${base_dir}/.git" ]]; then
        make_temp -d
        local shadow_git_dir_base="mount --bind '${tmp}' '${imgroot}/base_dir/.git'"
    fi

    local arg

    unshare --user --map-root-user --mount --pid --fork ${unshare_net_flag} -- sh -c "
        set -e

        mount -o ro --bind '${imgroot}' '${imgroot}'

        mount --rbind --make-rslave /dev '${imgroot}/dev'
        mount -t proc proc '${imgroot}/proc'
        mount --rbind --make-rslave /sys '${imgroot}/sys'
        mount -t tmpfs run '${imgroot}/run'
        mount -t tmpfs tmpfs '${imgroot}/tmp'
        mount -t tmpfs tmpfs '${imgroot}/var/tmp'

        mount -o ro --bind '${script}' '${imgroot}/jinx'
        mount ${container_base_dir_ro} --bind '${base_dir}' '${imgroot}/base_dir'
        mount --bind '${base_dir}/.jinx-cache/tmp' '${imgroot}/base_dir/.jinx-cache/tmp'
        mount --bind '${build_dir}' '${imgroot}/build_dir'
        mount ${container_sources_ro} --bind '${base_dir}/sources' '${imgroot}/base_dir/sources'
        mount ${container_sources_ro} --bind '${base_dir}/host-sources' '${imgroot}/base_dir/host-sources'
        ${container_pkgs_native_mount}
        ${sysroot_native_mount}
        ${shadow_git_dir_base}
        ${shadow_git_dir_build}

        env -i PATH='${PATH}' chroot '${imgroot}' /bin/sh -c '
            set -e

            cd /build_dir

            LD_PRELOAD=/nochown.so \
            HOME=/root \
            LANG=${run_in_cont_lang} \
            LC_COLLATE=C \
            PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin \
            LD_LIBRARY_PATH=/usr/local/lib64:/usr/local/lib:/usr/lib64:/usr/lib \
            ${run_in_cont_term} \
            ${run_in_cont_colorterm} \
            JINX_PARALLELISM=${parallelism} \
            JINX_CONFIG_FILE=/base_dir/Jinxfile \
            JINX_SOURCE_DIR=/base_dir \
            /bin/bash /jinx \
            $(for arg in "$@"; do printf '"%s" \\\n' "${arg//\"/\\\"}"; done)
            # keep this whitespace
        '
    "

    force_remove "${imgroot}/sysroot" "${imgroot}/base_dir" "${imgroot}/sources" "${imgroot}/host-sources" "${imgroot}/build_dir" "${imgroot}/jinx"
    rm "${imgroot}/etc/resolv.conf"
}

destroy_container() {
    force_remove "${container_pkgs}" "${sysroot}"
}

do_git_fetch() {
    if [[ -z ${commit} ]]; then
        die "* error: Git commit not specified"
    fi

    if [[ ! ${commit} =~ ^[0-9a-f]{40}$ ]]; then
        die "* error: Invalid commit hash"
    fi

    if [[ ${shallow} == no ]]; then
        git clone "${git_url}" "${base_dir}"/${_sources_root}/${name}
        git -C "${base_dir}"/${_sources_root}/${name} -c advice.detachedHead=false checkout "${commit}"
    else
        git clone "${git_url}" -c advice.detachedHead=false --revision="${commit}" --depth=1 "${base_dir}"/${_sources_root}/${name}
    fi
}

do_tarball_fetch() {
    local tarball_path="${base_dir}/${_sources_root}/$(basename "${tarball_url}")"

    if [[ ! -f $tarball_path ]]; then
        make_temp
        local download_path="${tmp}"

        curl -L -o "${download_path}" "${tarball_url}"
        mv "${download_path}" "${tarball_path}"
    fi

    local checksum_verified=no

    fill_recipe_checksum() {
        local var_name="$1"
        local checksum_value="$2"
        if [[ -n ${current_recipe_file} && -f ${current_recipe_file} ]]; then
            # Match `var=?`, `var="?"`, or `var='?'`
            # with optional surrounding whitespace, preserving whatever quoting style was used.
            sed -i -E "s#^([[:space:]]*${var_name}=)(\"|')?\\?(\"|')?([[:space:]]*)\$#\\1\\2${checksum_value}\\3\\4#" "${current_recipe_file}"
        else
            die "* error: cannot autofill ${var_name} for ${name}: recipe file unknown"
        fi
    }

    if [[ -n ${tarball_sha256} ]]; then
        local actual_sha256="$(sha256sum "${tarball_path}")"
        local actual_sha256="${actual_sha256%% *}"
        if [[ ${actual_sha256} != "${tarball_sha256}" ]]; then
            if [[ ${tarball_sha256} == "?" ]]; then
                fill_recipe_checksum tarball_sha256 "${actual_sha256}"
            else
                die "* error: Failed to verify SHA256 for ${name}.
  Expected '${tarball_sha256}';
  got '${actual_sha256}'."
            fi
        fi
        local checksum_verified=yes
    fi
    if [[ -n ${tarball_sha512} ]]; then
        local actual_sha512="$(sha512sum "${tarball_path}")"
        local actual_sha512="${actual_sha512%% *}"
        if [[ ${actual_sha512} != "${tarball_sha512}" ]]; then
            if [[ ${tarball_sha512} == "?" ]]; then
                fill_recipe_checksum tarball_sha512 "${actual_sha512}"
            else
                die "* error: Failed to verify SHA512 for ${name}.
  Expected '${tarball_sha512}';
  got '${actual_sha512}'."
            fi
        fi
        local checksum_verified=yes
    fi
    if [[ -n ${tarball_blake2b} ]]; then
        local actual_blake2b="$(b2sum "${tarball_path}")"
        local actual_blake2b="${actual_blake2b%% *}"
        if [[ ${actual_blake2b} != "${tarball_blake2b}" ]]; then
            if [[ ${tarball_blake2b} == "?" ]]; then
                fill_recipe_checksum tarball_blake2b "${actual_blake2b}"
            else
                die "* error: Failed to verify BLAKE2B for ${name}.
  Expected '${tarball_blake2b}';
  got '${actual_blake2b}'."
            fi
        fi
        local checksum_verified=yes
    fi

    if [[ ${checksum_verified} == no ]]; then
        die "* error: No checksum method specified for ${name}"
    fi

    make_temp -d
    local extract_dir="${tmp}"

    ( cd "${extract_dir}" && tar -xf "${tarball_path}" )

    mv "${extract_dir}"/* "${base_dir}"/${_sources_root}/${name} >/dev/null 2>&1 || (
        mkdir -p "${base_dir}"/${_sources_root}/${name}
        mv "${extract_dir}"/* "${base_dir}"/${_sources_root}/${name}/
    )

    force_remove "${extract_dir}" "${tarball_path}"
}

get_real_source_dir() {
    if [[ -z ${source_dir} && -z ${git_url} && -z ${tarball_url} ]]; then
        cat <<'EOF'
local source_dir=/dev/null
local is_local_package=true
local is_sourceless_package=true
EOF
        return
    fi

    cat <<'EOF'
local is_sourceless_package=
EOF

    if [[ -z ${source_dir} ]]; then
        cat <<'EOF'
local is_local_package=
EOF
        printf 'local source_dir=%q\n' "${base_dir}/${_sources_root}/${name}"
    else
        local _real_path="${base_dir}/${source_dir}"
        if [[ ! -d ${_real_path} ]]; then
            printf 'die %q\n' "* source_dir of a local package is not a valid path"
            return 1
        fi
        cat <<'EOF'
local is_local_package=true
EOF
        printf 'local source_dir=%q\n' "${_real_path}"
    fi
}

source_source_recipe() {
    local name="$1"
    local dir="$2"
    local _path="${base_dir}/${dir}/${name}"
    if [[ ! -f $_path/recipe ]]; then
        printf 'die %q\n' "* could not find recipe '${name}' in ${dir}/"
        return 1
    fi
    printf 'local current_recipe_file=%q\n' "${_path}/recipe"
    include_recipe "${_path}"

    cat <<'EOF'
local imagedeps="${source_imagedeps}"
local hostdeps="${source_hostdeps}"
local deps="${source_deps}"
local allow_network="${source_allow_network}"
EOF
}

do_fetch() {
    eval "$(source_source_recipe "$1" "$2")"

    eval "$(get_real_source_dir)"

    local sysroot=/sysroot

    if [[ ${is_local_package} != true && ${is_sourceless_package} != true ]]; then
        if [[ -n ${git_url} ]]; then
            do_git_fetch
        elif [[ -n ${tarball_url} ]]; then
            do_tarball_fetch
        fi
    fi

    if [[ ${is_sourceless_package} != true ]]; then
        tracked_subshell '
            cd "${source_dir}"
            early_prepare
        '
    fi
}

do_patch() {
    eval "$(source_source_recipe "$1" "$2")"

    eval "$(get_real_source_dir)"

    make_temp
    local patch_trash="${tmp}"

    cd "${source_dir}"

    local _patches_dir="${base_dir}/${_from_source_dir}/${name}/patches"
    local needs_match_timestamps=no
    force_remove "${base_dir}/${_sources_root}/${name}-clean"
    if [[ -d ${_patches_dir} ]]; then
        local patch
        for patch in "${_patches_dir}"/*; do
            [[ ${patch} == "${_patches_dir}/*" ]] && break
            [[ ${patch} == "${_patches_dir}/jinx-working-patch.patch" ]] && continue

            if [[ ! -d "${base_dir}/${_sources_root}/${name}-clean" ]]; then
                cp -rp "${source_dir}" "${base_dir}/${_sources_root}/${name}-clean"
                local needs_match_timestamps=yes
            fi

            patch --no-backup-if-mismatch -p1 -r "${patch_trash}" < "${patch}"
        done

        if [[ ${needs_match_timestamps} == yes ]]; then
            # make sure timestamps match
            local f
            for f in $(diff -rq --no-dereference "${base_dir}/${_sources_root}/${name}-clean" "${source_dir}" | sed '/^Only in/d;s/^Files //g;s/ and.*$//g'); do
                touch --reference="$f" "${f//${_sources_root}\/${name}-clean/${_sources_root}\/${name}}"
            done
            force_remove "${base_dir}/${_sources_root}/${name}-clean"
        fi
    fi

    cp -rp "${source_dir}" "${base_dir}/${_sources_root}/${name}-clean"

    if [[ -f "${_patches_dir}/jinx-working-patch.patch" ]]; then
        patch --no-backup-if-mismatch -p1 -r "${patch_trash}" < "${_patches_dir}/jinx-working-patch.patch"

        # make sure timestamps match
        local f
        for f in $(diff -rq --no-dereference "${base_dir}"/${_sources_root}/${name}-clean "${source_dir}" | sed '/^Only in/d;s/^Files //g;s/ and.*$//g'); do
            touch --reference="$f" "${f//${_sources_root}\/${name}-clean/${_sources_root}\/${name}}"
        done
    fi

    cp -rp "${source_dir}" "${base_dir}"/${_sources_root}/${name}-workdir

    cd "${base_dir}"
}

