[MODIFIED FOR GLOIRE] paths given an a/ b/ prefix so the patch applies at -p1, which is
what jinx uses; the diff itself is unchanged from Arch's.

--- a/Makefile	2022-02-02 20:30:23.352782993 -0800
+++ b/Makefile	2022-02-02 20:33:32.503983729 -0800
@@ -8,11 +8,12 @@

 CC=gcc
 CFLAGS=-O3 -Wall
+LDFLAGS+=-lncurses

 all: sl

 sl: sl.c sl.h
-	$(CC) $(CFLAGS) -o sl sl.c -lncurses
+	$(CC) $(CFLAGS) -o sl sl.c $(LDFLAGS)

 clean:
 	rm -f sl

