+
+#include <config.h>
+#include <glibtop.h>
+#include <glibtop/loadavg.h>
+
+#include <string.h>
+#include <stdint.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static const unsigned long _glibtop_sysdeps_loadavg =
+(1L << GLIBTOP_LOADAVG_LOADAVG);
+
+void
+_glibtop_init_loadavg_s (glibtop *server)
+{
+	server->sysdeps.loadavg = _glibtop_sysdeps_loadavg;
+}
+
+void
+glibtop_get_loadavg_s (glibtop *server, glibtop_loadavg *buf)
+{
+	uint32_t loads [3];
+
+	memset (buf, 0, sizeof (glibtop_loadavg));
+
+	if (syscall (SYS_loadavg, loads, sizeof (loads)) < 0)
+		return;
+
+	buf->loadavg [0] = (double) loads [0] / 100.0;
+	buf->loadavg [1] = (double) loads [1] / 100.0;
+	buf->loadavg [2] = (double) loads [2] / 100.0;
+
+	buf->flags = _glibtop_sysdeps_loadavg;
+}
diff --git libgtop-workdir/sysdeps/ironclad/mem.c libgtop-workdir/sysdeps/ironclad/mem.c
new file mode 100644
index 0000000..2209278
--- /dev/null
+++ libgtop-workdir/sysdeps/ironclad/mem.c
@@ -0,0 +1,60 @@
+/* Ironclad sysdeps for LibGTop.
+
+   Written for Gloire.  LibGTop is free software; you can redistribute it
+   and/or modify it under the terms of the GNU General Public License as
+   published by the Free Software Foundation; either version 2 of the
+   License, or (at your option) any later version.
+
+   LibGTop is distributed in the hope that it will be useful, but WITHOUT
+   ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+   FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+   for more details.
+*/
+
+#include <config.h>
+#include <glibtop.h>
+#include <glibtop/mem.h>
+
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#include "ironclad_private.h"
+
+static const unsigned long _glibtop_sysdeps_mem =
+(1L << GLIBTOP_MEM_TOTAL) + (1L << GLIBTOP_MEM_USED) +
+(1L << GLIBTOP_MEM_FREE) + (1L << GLIBTOP_MEM_SHARED) +
+(1L << GLIBTOP_MEM_USER);
+
+void
+_glibtop_init_mem_s (glibtop *server)
+{
+	server->sysdeps.mem = _glibtop_sysdeps_mem;
+}
+
+/* Ironclad reports memory in BYTES, which is what glibtop wants -- glibc's
+   own get_phys_pages() divides the same values by the page size to obtain
+   pages, so no scaling is needed here.  */
+void
+glibtop_get_mem_s (glibtop *server, glibtop_mem *buf)
+{
+	struct ironclad_meminfo mem;
+
+	memset (buf, 0, sizeof (glibtop_mem));
+
+	if (syscall (SYS_meminfo, &mem) != 0)
+		return;
+
+	/* phys_available is usable RAM; phys_total includes memory reserved by
+	   firmware and the kernel, which no application can have.  glibc makes
+	   the same choice for get_phys_pages().  */
+	buf->total  = mem.phys_available;
+	buf->free   = mem.phys_free;
+	buf->used   = (mem.phys_available > mem.phys_free)
+		       ? mem.phys_available - mem.phys_free : 0;
+	buf->shared = mem.shared_usage;
+	buf->user   = (buf->used > mem.shared_usage)
+		       ? buf->used - mem.shared_usage : 0;
+
+	buf->flags = _glibtop_sysdeps_mem;
+}
