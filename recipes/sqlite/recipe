#! /bin/sh

version=3.54.1
revision=1
zip_url="https://sqlite.org/2026/sqlite-src-3540100.zip"
zip_blake2b="1680ab90ba03b23c2f646a7cce891fce5940a86f9aaf58e0701accaf777c5a2fcf076ef595d3a9e2ce703c2af5835747dca2fe7838b9d01d5480e2693b25679c"
imagedeps="build-essential"
hostdeps="gcc pkg-config"
deps="core-libs readline zlib"

_tools="dbdump dbhash dbtotxt index_usage showdb showjournal showshm showstat4 \
        showwal sqldiff sqlite3_expert sqlite3_rsync"

prepare() {
    autotools_recursive_regen
}

configure() {
    TARGET_CFLAGS="${TARGET_CFLAGS//_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"

    "${source_dir}/configure" \
        --host=${OS_TRIPLET} \
        --prefix=${prefix} \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --bindir=${prefix}/bin \
        --sbindir=${prefix}/bin \
        --libdir=${prefix}/lib \
        --soname=legacy \
        --disable-static \
        --disable-rpath \
        --disable-tcl \
        --enable-shared \
        --enable-fts3 \
        --enable-fts4 \
        --enable-fts5 \
        --enable-rtree \
        --enable-session \
        --enable-readline \
        --with-readline-header=${sysroot}${prefix}/include/readline/readline.h \
        CFLAGS="${TARGET_CFLAGS} \
            -DSQLITE_ENABLE_COLUMN_METADATA=1 \
            -DSQLITE_ENABLE_UNLOCK_NOTIFY=1 \
            -DSQLITE_ENABLE_DBSTAT_VTAB=1 \
            -DSQLITE_ENABLE_FTS3_PARENTHESIS \
            -DSQLITE_SECURE_DELETE=1 \
            -DSQLITE_ENABLE_STMTVTAB \
            -DSQLITE_ENABLE_STAT4 \
            -DSQLITE_ENABLE_MATH_FUNCTIONS \
            -DSQLITE_MAX_VARIABLE_NUMBER=250000 \
            -DSQLITE_MAX_EXPR_DEPTH=10000" \
        LDFLAGS="${TARGET_LDFLAGS}"
}

build() {
    make -j${parallelism}

    make -j${parallelism} ${_tools}
}

package() {
    DESTDIR="${dest_dir}" make install

    install -v -m755 ${_tools} "${dest_dir}${prefix}"/bin

    post_package_strip
}
