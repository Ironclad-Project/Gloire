#! /bin/sh

repology_id=libsoup
version=3.8.1
revision=1
tarball_url="https://download.gnome.org/sources/libsoup/3.8/libsoup-${version}.tar.xz"
tarball_blake2b="ea8343de2620885f5d978cfcd61b0fc1edeb4f02113b8ec92164b541ccc04afcc99cd536cd98b9ebc7e8f89802993b16a9d33b6c74213f15ee4a5e9f0390fb9e"
imagedeps="libglib2.0-dev-bin"
hostdeps="gcc pkg-config"
deps="core-libs brotli glib-networking glib2 libnghttp2 libpsl sqlite zlib"

configure() {
    meson_configure \
        -Dtests=false \
        -Dpkcs11_tests=disabled \
        -Dvapi=disabled \
        -Dintrospection=disabled \
        -Dgssapi=disabled \
        -Dsysprof=disabled \
        -Dntlm=disabled \
        -Dautobahn=disabled \
        -Ddocs=disabled \
        -Dtls_check=false
}

build() {
    meson compile --verbose -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
