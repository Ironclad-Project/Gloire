#! /bin/sh

version=1.11.0
revision=1
tarball_url="https://github.com/lz4/lz4/releases/download/v${version}/lz4-${version}.tar.gz"
tarball_blake2b="f8e00d63176fcb038acdb101c67ce284d7137dd8d5cc05adf837eeb7ad8ea0ff846dda3f6ffbfd0c93ccb95b2a1ce409f5f8645caf77a36823a03d4cb515432b"
imagedeps="build-essential"
hostdeps="gcc pkg-config"
deps="core-libs"

configure() {
        meson_source_dir="${source_dir}"/build/meson \
    meson_configure \
        -Dcontrib=true \
        -Dossfuzz=false \
        -Dexamples=true \
        -Dprograms=true
}

build() {
    meson compile --verbose -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
