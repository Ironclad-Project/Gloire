diff --git libgtop-workdir/sysdeps/ironclad/netlist.c libgtop-workdir/sysdeps/ironclad/netlist.c
new file mode 100644
index 0000000..0afb44e
--- /dev/null
+++ libgtop-workdir/sysdeps/ironclad/netlist.c
@@ -0,0 +1,88 @@
+/* Ironclad sysdeps for LibGTop.
+
+   Written for Gloire.  LibGTop is free software; you can redistribute it
+   and/or modify it under the terms of the GNU General Public License as
+   published by the Free Software Foundation; either version 2 of the
+   License, or (at your option) any later version.
+
+   LibGTop is distributed in the hope that it will be useful, but WITHOUT
+   ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+   FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+   for more details.
+*/
+
+#include <config.h>
+#include <glibtop.h>
+#include <glibtop/netlist.h>
+
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#include "ironclad_private.h"
+
+static const unsigned long _glibtop_sysdeps_netlist =
+(1L << GLIBTOP_NETLIST_NUMBER);
+
+void
+_glibtop_init_netlist_s (glibtop *server)
+{
+	server->sysdeps.netlist = _glibtop_sysdeps_netlist;
+}
+
+char **
+glibtop_get_netlist_s (glibtop *server, glibtop_netlist *buf)
+{
+	struct ironclad_netinter *ifs;
+	long ret;
+	unsigned long n = 16;
+	GPtrArray *names;
+	long i;
+
+	memset (buf, 0, sizeof (glibtop_netlist));
+
+	ifs = malloc (n * sizeof (struct ironclad_netinter));
+	if (ifs == NULL)
+		return g_new0 (char *, 1);
+
+	ret = syscall (SYS_listnetinter, ifs, n);
+	if (ret < 0) {
+		free (ifs);
+		return g_new0 (char *, 1);
+	}
+	if ((unsigned long) ret > n) {
+		struct ironclad_netinter *grown;
+
+		n = (unsigned long) ret;
+		grown = realloc (ifs, n * sizeof (struct ironclad_netinter));
+		if (grown == NULL) {
+			free (ifs);
+			return g_new0 (char *, 1);
+		}
+		ifs = grown;
+		ret = syscall (SYS_listnetinter, ifs, n);
+		if (ret < 0) {
+			free (ifs);
+			return g_new0 (char *, 1);
+		}
+		if ((unsigned long) ret > n)
+			ret = (long) n;
+	}
+
+	names = g_ptr_array_new ();
+	for (i = 0; i < ret; i++) {
+		char name [sizeof (ifs [i].devname) + 1];
+
+		memcpy (name, ifs [i].devname, sizeof (ifs [i].devname));
+		name [sizeof (ifs [i].devname)] = 0;
+		g_ptr_array_add (names, g_strdup (name));
+	}
+	free (ifs);
+
+	buf->number = names->len;
+	buf->flags  = _glibtop_sysdeps_netlist;
+
+	g_ptr_array_add (names, NULL);
+	return (char **) g_ptr_array_free (names, FALSE);
+}
