+
+// The wait-status accessors, transcribed from Ironclad's OWN
+// sysdeps/unix/sysv/ironclad/bits/waitstatus.h, which documents the encoding in
+// terms: bits 0-7 exit status, bit 8 continued, bit 9 exited, bit 10 signaled,
+// bit 11 stopped, bits 16-23 stop signal, bits 24-31 termination signal.
+//
+// ***THIS IS NOT LINUX'S ENCODING AND NOT ANY OTHER GLIBC PORT'S.*** Linux has
+// WEXITSTATUS as (status & 0xff00) >> 8 and WIFEXITED as (status & 0x7f) == 0;
+// here they are (status & 0xff) and bit 9. Taking another platform's definitions
+// would compile perfectly and misreport the outcome of EVERY child process --
+// note __W_EXITCODE(0, 0) is 0x200 here, so a successful exit is not zero.
+pub const MAP_FAILED: *mut c_void = !0 as *mut c_void;
+
+safe_f! {
+    // TRANSCRIBED from our own bits/sysmacros.h __SYSMACROS_DEFINE_* macros rather
+    // than copied from another platform. They must be SAFE functions: the libc
+    // crate declares them so everywhere else, and callers -- rustix's makedev.rs
+    // among them -- invoke them outside an unsafe block.
+    pub const fn major(dev: crate::dev_t) -> c_uint {
+        let mut major = 0;
+        major |= (dev & 0x0000_0000_000f_ff00) >> 8;
+        major |= (dev & 0xffff_f000_0000_0000) >> 32;
+        major as c_uint
+    }
+
+    pub const fn minor(dev: crate::dev_t) -> c_uint {
+        let mut minor = 0;
+        minor |= dev & 0x0000_0000_0000_00ff;
+        minor |= (dev & 0x0000_0fff_fff0_0000) >> 12;
+        minor as c_uint
+    }
+
+    pub const fn makedev(major: c_uint, minor: c_uint) -> crate::dev_t {
+        let major = major as crate::dev_t;
+        let minor = minor as crate::dev_t;
+        let mut dev = 0;
+        dev |= (major & 0x0000_0fff) << 8;
+        dev |= (major & 0xffff_f000) << 32;
+        dev |= minor & 0x0000_00ff;
+        dev |= (minor & 0xffff_ff00) << 12;
+        dev
+    }
+
+    pub const fn WEXITSTATUS(status: c_int) -> c_int {
+        status & 0x000000FF
+    }
+
+    pub const fn WIFCONTINUED(status: c_int) -> bool {
+        (status & 0x00000100) != 0
+    }
+
+    pub const fn WIFEXITED(status: c_int) -> bool {
+        (status & 0x00000200) != 0
+    }
+
+    pub const fn WIFSIGNALED(status: c_int) -> bool {
+        (status & 0x00000400) != 0
+    }
+
+    pub const fn WIFSTOPPED(status: c_int) -> bool {
+        (status & 0x00000800) != 0
+    }
+
+    pub const fn WSTOPSIG(status: c_int) -> c_int {
+        (status & 0x00FF0000) >> 16
+    }
+
+    pub const fn WTERMSIG(status: c_int) -> c_int {
+        ((status as u32 & 0xFF000000) >> 24) as c_int
+    }
+
+    pub const fn WCOREDUMP(status: c_int) -> bool {
+        (status & 0x80) != 0
+    }
+
+    pub const fn W_EXITCODE(ret: c_int, sig: c_int) -> c_int {
+        ret | (sig << 24) | 0x200
+    }
+
+    pub const fn W_STOPCODE(sig: c_int) -> c_int {
+        (sig << 16) | 0x800
+    }
+}
