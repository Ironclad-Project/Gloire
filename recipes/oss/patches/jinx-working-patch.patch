+  cairo_fill (cr);
 
-GtkType
-gtk_vu_get_type (void)
-{
-  static GtkType vu_type = 0;
+  margin = alloc.width / 3;
+  y_size = (alloc.height - 50) / VU_SEGMENTS;
+  if (y_size < 1)
+    y_size = 1;
 
-  if (!vu_type)
