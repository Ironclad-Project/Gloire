#! /bin/sh

version=26.2.6
revision=1
tarball_url="https://archive.mesa3d.org/mesa-${version}.tar.xz"
tarball_blake2b="48b782cf78ab81edefd049f32074c9ccc2891402cdd0a6298037d0ee8c5f4c1e6cf9386fc196c201beea89a3c4cbfee53aa84c3bd0cc91865b6fce25494cd630"
imagedeps="python3-mako python3-yaml python3-lxml python3-rnc2rng glslang-tools"
hostdeps="gcc pkg-config"
deps="core-libs llvm-libs libexpat libx11 libxcb libxext libxshmfence libxxf86vm libxrandr zlib zstd"

configure() {
    meson_configure \
        -Dglx=xlib \
        -Dplatforms=x11 \
        -Dgallium-drivers=llvmpipe,softpipe \
        -Dvulkan-drivers=swrast \
        -Dgbm=disabled \
        -Degl=disabled \
        -Dglvnd=disabled \
        -Dxlib-lease=disabled \
        -Dallow-kcmp=disabled \
        -Dandroid-libbacktrace=disabled \
        -Dandroid-libperfetto=disabled \
        -Dgallium-va=disabled \
        -Dgallium-mediafoundation=disabled \
        -Dgallium-d3d12-video=disabled \
        -Dgallium-d3d12-graphics=disabled \
        -Dmicrosoft-clc=disabled \
        -Dintel-rt=disabled \
        -Dpower8=disabled \
        -Ddisplay-info=disabled \
        -Dspirv-tools=disabled \
        -Dlmsensors=disabled \
        -Dlibunwind=disabled \
        -Dvalgrind=disabled \
        -Dvideo-codecs=all_free \
        -Denable-glcpp-tests=false
}

build() {
    meson compile --verbose -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
