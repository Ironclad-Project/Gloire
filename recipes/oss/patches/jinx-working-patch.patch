     {
-      GtkTypeInfo vu_info = {
-	"GtkVU",
-	sizeof (GtkVU),
-	sizeof (GtkVUClass),
-	(GtkClassInitFunc) gtk_vu_class_init,
-	(GtkObjectInitFunc) gtk_vu_init,
-	NULL,
-	NULL,
-      };
-
-      vu_type = gtk_type_unique (gtk_widget_get_type (), &vu_info);
+      gdk_cairo_set_source_rgba (cr,
+				 &vu_colors[((7 - i) / 3) * 2 +
+					    (((VU_SEGMENTS - vu->level) > i) ?
+					     0 : 1)]);
+      cairo_rectangle (cr, margin, (i * (y_size + 5)) + 10,
+		       alloc.width - margin * 2, y_size);
