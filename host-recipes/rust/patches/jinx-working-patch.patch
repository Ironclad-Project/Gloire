index 0000000..a8d9674
--- /dev/null
+++ rust-workdir/compiler/rustc_target/src/spec/targets/x86_64_unknown_ironclad_gnu.rs
@@ -0,0 +1,28 @@
+use crate::spec::{
+    Arch, Cc, LinkerFlavor, Lld, StackProbeType, Target, TargetMetadata, base,
+};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::ironclad_gnu::opts();
+    base.cpu = "x86-64".into();
+    base.max_atomic_width = Some(64);
+    base.add_pre_link_args(LinkerFlavor::Gnu(Cc::Yes, Lld::No), &["-m64"]);
+    base.stack_probes = StackProbeType::Inline;
+
+    Target {
+        // Handed straight to LLVM, which resolves `ironclad` through parseOS to
+        // Triple::Ironclad; without that entry it would read as UnknownOS.
+        llvm_target: "x86_64-unknown-ironclad-gnu".into(),
+        metadata: TargetMetadata {
+            description: Some("Ironclad/amd64".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout:
+            "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128".into(),
+        arch: Arch::X86_64,
+        options: base,
+    }
+}
