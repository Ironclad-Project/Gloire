diff --git pv-clean/src/pv/file.c pv-workdir/src/pv/file.c
index be3b69c..e97a1d2 100644
--- pv-clean/src/pv/file.c
+++ pv-workdir/src/pv/file.c
@@ -36,6 +36,7 @@ bool pv_fd_is_dev_null(int fd, bool report_error)
 	struct stat sb;
 	struct utsname uts;
 	unsigned long expected_rdev;
+	bool check_rdev;
 	bool is_dev_null;
 
 	if (fd < 0)
@@ -49,6 +50,7 @@ bool pv_fd_is_dev_null(int fd, bool report_error)
 	}
 
 	expected_rdev = 0x0103;		    /* device 1,3 on Linux. */
+	check_rdev = true;
 
 	is_dev_null = true;
 	if (!S_ISCHR(sb.st_mode)) {
@@ -66,10 +68,20 @@ bool pv_fd_is_dev_null(int fd, bool report_error)
 			expected_rdev = 0x0202;
 		} else if (0 == strncmp(uts.sysname, "Darwin", 6)) {
 			expected_rdev = 0x03000002;
+		} else if (0 == strncmp(uts.sysname, "Ironclad", 8)) {
+			/*
+			 * Ironclad does not use traditional major/minor
+			 * device numbers, so there is no rdev value that
+			 * could be compared against here; the S_ISCHR()
+			 * test above is all that can meaningfully be
+			 * checked.  Its glibc port skips the identical
+			 * test in check_fds.c for the same reason.
+			 */
+			check_rdev = false;
 		}
 	}
 
-	if ((unsigned long) (sb.st_rdev) != expected_rdev) {
+	if (check_rdev && (unsigned long) (sb.st_rdev) != expected_rdev) {
 		debug("/dev/null: fd is %08lx, expected %08lx", sb.st_rdev, expected_rdev);
 		is_dev_null = false;
 	}
