#! /bin/sh

version=1.28.2
revision=1
tarball_url="https://github.com/mate-desktop/mate-control-center/releases/download/v${version}/mate-control-center-${version}.tar.xz"
tarball_blake2b="097cdf9f3ef055b91dabccfd8a8326ccdcb8a93fb42509f1ab19882f8104b68a2298a81b9738e5005e05b5ead523c41f73acdaab95d1511f494046ed74073dc6"
imagedeps="libglib2.0-dev-bin libglib2.0-bin gtk-update-icon-cache"
hostdeps="gcc pkg-config"
deps="core-libs at-spi2-core cairo dconf fontconfig freetype2 gdk-pixbuf glib2 gtk3 libmatekbd libx11 libxcursor libxi libxklavier libxml2 marco mate-desktop mate-menus pango shared-mime-info"
builddeps="libxscrnsaver"

configure() {
    meson_configure \
        -Daccountsservice=disabled
}

build() {
    meson compile --verbose -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip

    generate_glib_schemas_hook
    generate_mime_database_hook
}
