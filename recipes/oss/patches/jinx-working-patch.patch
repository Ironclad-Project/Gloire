diff --git oss-workdir/Makefile.ironclad oss-workdir/Makefile.ironclad
new file mode 100644
index 0000000..fa14dda
--- /dev/null
+++ oss-workdir/Makefile.ironclad
@@ -0,0 +1,408 @@
+#
+# Makefile for the Ironclad (Gloire) user land port of Open Sound System.
+#
+# OSS normally builds through configure -> setup/setupdir.sh -> srcconf, which
+# derives the target OS from `uname -s`, builds and runs helper programs on the
+# build host, and then builds the kernel drivers along with the user land.
+# None of that survives cross compilation, and Ironclad has no in-kernel OSS
+# implementation to build drivers against, so this Makefile builds the user
+# land - the libraries, the command line utilities and their manual pages -
+# directly.
+#
+# Everything it produces is byte for byte the same set of objects the stock
+# Linux build produces from cmd/ and lib/; the only pieces left out are the
+# kernel modules, ossdetect/ossvermagic/soundon/soundoff (Linux module loading)
+# and libsalsa (needs the ALSA headers, which Gloire does not ship).
+#
+# Usage:
+#	make -f Makefile.ironclad          CC=... CFLAGS=... LDFLAGS=...
+#	make -f Makefile.ironclad install  DESTDIR=...
+#
+
+SHELL		= /bin/sh
+
+prefix		?= /usr
+bindir		?= $(prefix)/bin
+libdir		?= $(prefix)/lib
+includedir	?= $(prefix)/include
+mandir		?= $(prefix)/share/man
+sysconfdir	?= /etc
+OSSLIBDIR	?= $(libdir)/oss
+
+CC		?= cc
+HOSTCC		?= cc
+INSTALL		?= install
+LN_S		?= ln -sf
+CFLAGS		?= -O2
+CPPFLAGS	?=
+LDFLAGS		?=
+GZIP		?= gzip -9n
+
+DESTDIR		?=
+
+#
+# Configuration knobs.  These mirror the ones the stock ./configure accepts
+# and end up in the generated local_config.h exactly as srcconf.c writes them.
+#
+CONFIG_MIDI		?= 1
+CONFIG_VMIX		?= 1
+CONFIG_VMIX_FLOAT	?= 1
+GRC_MIN_QUALITY		?= 3
+GRC_MAX_QUALITY		?= 3
+
+# ossplay can read Ogg Vorbis files by dlopen()ing libvorbisfile.  Needs
+# <vorbis/vorbisfile.h> at build time, nothing at link time.
+OGG_SUPPORT		?= 0
+
+# Build ID and version, as reported by "ossinfo -v" and written to version.dat.
+OSS_BUILD_ID		?= 2020
+OSS_VERSION		?= 4.2
+
+GENINC		= kernel/framework/include
+INCLUDES	= -Iinclude -I$(GENINC) -Ikernel/OS/Ironclad -I.
+
+# srcconf passes -DOSS_LITTLE_ENDIAN / -DOSS_BIG_ENDIAN based on the *build*
+# host.  Ask the target compiler instead - __BYTE_ORDER__ is a builtin, so this
+# needs no headers and works before anything has been generated.
+OSS_ENDIAN	:= $(shell echo '__BYTE_ORDER__ __ORDER_BIG_ENDIAN__' \
+		     | $(CC) -E -P -xc - | awk 'NF==2 { print ($$1==$$2) ? "BIG" : "LITTLE" }')
+
+ALL_CFLAGS	= $(CFLAGS) -DOSS_$(OSS_ENDIAN)_ENDIAN $(CPPFLAGS) $(INCLUDES)
+
+# The build timestamp OSS bakes into the version string.  Honour
+# SOURCE_DATE_EPOCH so repeated builds of the same commit are reproducible.
+BUILD_DATE	:= $(shell date -u +%Y%m%d%H%M -d "@$${SOURCE_DATE_EPOCH:-$$(date +%s)}" 2>/dev/null || date -u +%Y%m%d%H%M)
+
+GENERATED	= $(GENINC)/local_config.h \
+		  $(GENINC)/buildid.h \
+		  $(GENINC)/timestamp.h \
+		  $(GENINC)/oss_errno.h \
+		  $(GENINC)/ossddk/oss_limits.h \
+		  $(GENINC)/os.h \
+		  version.dat
+
+#
+# Libraries.  Upstream ships these without an soname out of $(OSSLIBDIR)/lib;
+# Gloire puts shared libraries in $(libdir) and expects a versioned soname.
+#
+LIBOSSLIB_SRCS	= lib/libOSSlib/libmain.c \
+		  lib/libOSSlib/midiparser.c \
+		  lib/libOSSlib/play_event.c
+LIBOSSMIX_SRCS	= lib/libossmix/libossmix_cache.c \
+		  lib/libossmix/libossmix_local.c \
+		  lib/libossmix/libossmix_main.c \
+		  lib/libossmix/libossmix_tcp.c
+
+LIBOSSLIB_SONAME = libOSSlib.so.0
+LIBOSSMIX_SONAME = libossmix.so.0
+
+LIBS		= target/lib/$(LIBOSSLIB_SONAME) target/lib/$(LIBOSSMIX_SONAME)
+
+#
+# Utilities.  BIN_PROGS land in $(bindir), SBIN_PROGS are the administrative
+# ones - upstream installs them in /usr/sbin and documents them in section 8.
+# Gloire has a merged /usr/bin, so they all end up there, but the manual page
+# sections are kept as upstream has them.
+#
+BIN_PROGS	= ossinfo ossmix ossplay osstest ossphone osspartysh
+SBIN_PROGS	= ossdevlinks savemixer vmixctl ossmixd
+
+PROGS		= $(addprefix target/bin/,$(BIN_PROGS)) \
+		  $(addprefix target/sbin/,$(SBIN_PROGS))
+
+# Manual pages that do not belong to a single command.
+MAN7		= dsp midi mixer sndstat
+
+.PHONY: all clean install install-headers install-libs install-progs install-man install-etc
+.SUFFIXES:
+
+all: $(LIBS) $(PROGS) target/bin/ossrecord man
+
+#
+# ---------------------------------------------------------------- generated
+#
+
+$(GENINC)/local_config.h:
+	@echo "  GEN     $@"
+	@{ \
+	  echo "/*"; \
+	  echo " * Automatically generated by Makefile.ironclad - Do not edit."; \
+	  echo "*/"; \
+	  echo "#define CONFIG_OSS_GRC_MIN_QUALITY $(GRC_MIN_QUALITY)"; \
+	  echo "#define CONFIG_OSS_GRC_MAX_QUALITY $(GRC_MAX_QUALITY)"; \
+	  if [ "$(CONFIG_VMIX)" = 1 ]; then \
+	    echo "#define CONFIG_OSS_VMIX"; \
+	    if [ "$(CONFIG_VMIX_FLOAT)" = 1 ]; then \
+	      echo "#define CONFIG_OSS_VMIX_FLOAT"; \
+	    else \
+	      echo "#undef  CONFIG_OSS_VMIX_FLOAT"; \
+	    fi; \
+	  else \
+	    echo "#undef  CONFIG_OSS_VMIX"; \
+	  fi; \
+	  if [ "$(CONFIG_MIDI)" = 1 ]; then \
+	    echo "#define CONFIG_OSS_MIDI"; \
+	  else \
+	    echo "#undef  CONFIG_OSS_MIDI"; \
+	  fi; \
+	} > $@
+
+$(GENINC)/buildid.h:
+	@echo "  GEN     $@"
+	@{ \
+	  echo "#define OSS_BUILD_ID \"$(OSS_BUILD_ID)\""; \
+	  echo "#define __OPENOSS__"; \
+	  echo "#define OSS_LICENSE \"$$(cat .license 2>/dev/null || echo OSS_HG)\""; \
+	} > $@
+
+$(GENINC)/timestamp.h:
+	@echo "  GEN     $@"
+	@echo "#define OSS_COMPILE_DATE \"$(BUILD_DATE)\"" > $@
+
+$(GENINC)/oss_errno.h: setup/Ironclad/gen-oss-errno.sh
+	@echo "  GEN     $@"
+	@sh setup/Ironclad/gen-oss-errno.sh "$(CC) $(CPPFLAGS)" > $@
+
+# Upstream symlinks the .PHh through phpmake; without phpmake the file is
+# already valid C, so just use it.
+$(GENINC)/ossddk/oss_limits.h: $(GENINC)/ossddk/oss_limits.PHh
+	@echo "  GEN     $@"
+	@cp -f $< $@
+
+$(GENINC)/os.h: kernel/OS/Ironclad/os_ironclad.h
+	@echo "  GEN     $@"
+	@cp -f $< $@
+
+version.dat: $(GENINC)/buildid.h $(GENINC)/timestamp.h
+	@echo "  GEN     $@"
+	@echo "$(OSS_VERSION) (b $(OSS_BUILD_ID)/$(BUILD_DATE))" > $@
+
+#
+# ------------------------------------------------------------------ libraries
+#
+
+target/lib/$(LIBOSSLIB_SONAME): $(LIBOSSLIB_SRCS) $(GENERATED)
+	@mkdir -p target/lib
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) -fPIC -shared -Wl,-soname,$(LIBOSSLIB_SONAME) \
+		-o $@ $(LIBOSSLIB_SRCS) $(LDFLAGS)
+
+target/lib/$(LIBOSSMIX_SONAME): $(LIBOSSMIX_SRCS) $(GENERATED)
+	@mkdir -p target/lib
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) -fPIC -shared -Wl,-soname,$(LIBOSSMIX_SONAME) \
+		-o $@ $(LIBOSSMIX_SRCS) $(LDFLAGS)
+	@$(LN_S) $(LIBOSSMIX_SONAME) target/lib/libossmix.so
+
+#
+# ------------------------------------------------------------------ utilities
+#
+
+target/bin/ossinfo: cmd/ossinfo/ossinfo.c $(GENERATED)
+	@mkdir -p target/bin
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) -o $@ $< $(LDFLAGS)
+
+target/bin/ossmix: cmd/ossmix/ossmix.c $(GENERATED)
+	@mkdir -p target/bin
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) -o $@ $< $(LDFLAGS)
+
+target/bin/ossphone: cmd/ossphone/ossphone.c $(GENERATED)
+	@mkdir -p target/bin
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) -o $@ $< $(LDFLAGS) -lm
+
+target/bin/osspartysh: cmd/osspartysh/osspartysh.c $(GENERATED)
+	@mkdir -p target/bin
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) -o $@ $< $(LDFLAGS) -lutil
+
+OSSPLAY_SRCS	= cmd/ossplay/ossplay.c \
+		  cmd/ossplay/ossplay_console.c \
+		  cmd/ossplay/ossplay_decode.c \
+		  cmd/ossplay/ossplay_parser.c \
+		  cmd/ossplay/ossplay_wparser.c
+ifeq ($(OGG_SUPPORT),1)
+OSSPLAY_CFLAGS	= -DOGG_SUPPORT
+endif
+
+target/bin/ossplay: $(OSSPLAY_SRCS) $(GENERATED)
+	@mkdir -p target/bin
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) $(OSSPLAY_CFLAGS) -o $@ $(OSSPLAY_SRCS) $(LDFLAGS) -ldl
+
+# ossrecord is the same binary under a different argv[0].
+target/bin/ossrecord: target/bin/ossplay
+	@echo "  LN      $@"
+	@$(LN_S) ossplay $@
+
+OSSTEST_SRCS	= cmd/osstest/help.c cmd/osstest/osstest.c cmd/osstest/wavedata.c
+
+target/bin/osstest: $(OSSTEST_SRCS) $(GENERATED)
+	@mkdir -p target/bin
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) -DSRC_SUPPORT -o $@ $(OSSTEST_SRCS) $(LDFLAGS)
+
+target/sbin/ossdevlinks: cmd/ossdevlinks/ossdevlinks.c $(GENERATED)
+	@mkdir -p target/sbin
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) -o $@ $< $(LDFLAGS)
+
+target/sbin/savemixer: cmd/savemixer/savemixer.c $(GENERATED)
+	@mkdir -p target/sbin
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) -o $@ $< $(LDFLAGS)
+
+target/sbin/vmixctl: cmd/vmixctl/vmixctl.c $(GENERATED)
+	@mkdir -p target/sbin
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) -o $@ $< $(LDFLAGS)
+
+target/sbin/ossmixd: cmd/ossmixd/ossmixd.c $(GENERATED) target/lib/$(LIBOSSMIX_SONAME)
+	@mkdir -p target/sbin
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) -o $@ $< $(LDFLAGS) -Ltarget/lib -lossmix
+
+#
+# ---------------------------------------------------------------- manual pages
+#
+# Upstream renders the .man sources with txt2man; the gawk script is preferred
+# when available, but the C version shipped in setup/ is the documented
+# fallback and needs nothing but a host compiler.
+#
+
+# ossmixd is the one utility upstream ships without a manual page.
+MAN_SBIN_PROGS	= $(filter-out ossmixd,$(SBIN_PROGS))
+
+# ossmixd is the one utility upstream ships without a manual page.
+MAN_SBIN_PROGS	= $(filter-out ossmixd,$(SBIN_PROGS))
+# ossrecord is built from cmd/ossplay but documented on its own.
+MAN_BIN_PROGS	= $(BIN_PROGS) ossrecord
+
+MAN_BIN_PAGES	= $(addprefix target/man/man1/,$(addsuffix .1.gz,$(MAN_BIN_PROGS)))
+MAN_SBIN_PAGES	= $(addprefix target/man/man8/,$(addsuffix .8.gz,$(MAN_SBIN_PROGS)))
+MAN_DEV_PAGES	= $(addprefix target/man/man7/,$(addsuffix .7.gz,$(MAN7)))
+
+.PHONY: man
+man: $(MAN_BIN_PAGES) $(MAN_SBIN_PAGES) $(MAN_DEV_PAGES)
+
+target/txt2man: setup/txt2man.c
+	@mkdir -p target
+	@echo "  HOSTCC  $@"
+	@$(HOSTCC) -O2 -o $@ $<
+
+# $(1) command, $(2) source directory, $(3) section, $(4) volume title
+# txt2man only reads a named file, so the CONFIGFILEPATH substitution upstream
+# does inline has to go through a temporary.
+define txt2man_rule
+target/man/man$(3)/$(1).$(3).gz: $(2)/$(1).man target/txt2man
+	@mkdir -p target/man/man$(3)
+	@echo "  MAN     $$@"
+	@sed "s:CONFIGFILEPATH:$(OSSLIBDIR)/conf:g" < $$< > target/man/$(1).$(3).txt
+	@./target/txt2man -t "$(1)" -v "$(4)" -s $(3) target/man/$(1).$(3).txt \
+	  | $(GZIP) > $$@
+	@rm -f target/man/$(1).$(3).txt
+endef
+
+$(foreach p,$(MAN_BIN_PROGS),\
+  $(eval $(call txt2man_rule,$(p),cmd/$(p),1,OSS User Commands)))
+$(foreach p,$(MAN_SBIN_PROGS),\
+  $(eval $(call txt2man_rule,$(p),cmd/$(p),8,OSS System Administration Commands)))
+$(foreach p,$(MAN7),\
+  $(eval $(call txt2man_rule,$(p),misc/man7,7,OSS Devices)))
+
+#
+# --------------------------------------------------------------------- ossxmix
+#
+# The GTK mixer GUI is the only part of the user land that needs a toolkit, so
+# it is a separate target (and a separate Gloire package) rather than part of
+# "all".  Upstream's ossxmix is GTK1/GTK2 code; it has been ported to GTK3 for
+# Gloire, which is the only GTK version Gloire ships.
+#
+
+PKG_CONFIG	?= pkg-config
+GTK_CFLAGS	?= $(shell $(PKG_CONFIG) --cflags gtk+-3.0)
+GTK_LIBS	?= $(shell $(PKG_CONFIG) --libs gtk+-3.0)
+
+OSSXMIX_SRCS	= cmd/ossxmix/ossxmix.c cmd/ossxmix/gtkvu.c
+
+# GtkStatusIcon and gdk_pixbuf_new_from_xpm_data are deprecated in GTK3 but
+# have no replacement that keeps the tray icon working.
+OSSXMIX_CFLAGS	= -Icmd/ossxmix -Wno-deprecated-declarations
+
+.PHONY: ossxmix install-ossxmix
+ossxmix: target/bin/ossxmix target/man/man1/ossxmix.1.gz
+
+target/bin/ossxmix: $(OSSXMIX_SRCS) $(GENERATED)
+	@mkdir -p target/bin
+	@echo "  CCLD    $@"
+	$(CC) $(ALL_CFLAGS) $(OSSXMIX_CFLAGS) $(GTK_CFLAGS) -o $@ $(OSSXMIX_SRCS) $(LDFLAGS) $(GTK_LIBS)
+
+$(eval $(call txt2man_rule,ossxmix,cmd/ossxmix,1,OSS User Commands))
+
+install-ossxmix: ossxmix
+	$(INSTALL) -d "$(DESTDIR)$(bindir)" "$(DESTDIR)$(mandir)/man1"
+	$(INSTALL) -m 755 target/bin/ossxmix "$(DESTDIR)$(bindir)/ossxmix"
+	$(INSTALL) -m 644 target/man/man1/ossxmix.1.gz "$(DESTDIR)$(mandir)/man1/"
+
+#
+# -------------------------------------------------------------------- install
+#
+
+install: install-headers install-libs install-progs install-man install-etc
+
+install-headers:
+	$(INSTALL) -d "$(DESTDIR)$(includedir)/sys"
+	$(INSTALL) -m 644 include/soundcard.h "$(DESTDIR)$(includedir)/sys/soundcard.h"
+	$(INSTALL) -m 644 include/libossmix.h "$(DESTDIR)$(includedir)/libossmix.h"
+	$(INSTALL) -m 644 include/oss_userdev_exports.h "$(DESTDIR)$(includedir)/oss_userdev_exports.h"
+	$(INSTALL) -m 644 lib/libOSSlib/midiparser.h "$(DESTDIR)$(includedir)/midiparser.h"
+
+install-libs: $(LIBS)
+	$(INSTALL) -d "$(DESTDIR)$(libdir)"
+	$(INSTALL) -m 755 target/lib/$(LIBOSSLIB_SONAME) "$(DESTDIR)$(libdir)/"
+	$(INSTALL) -m 755 target/lib/$(LIBOSSMIX_SONAME) "$(DESTDIR)$(libdir)/"
+	$(LN_S) $(LIBOSSLIB_SONAME) "$(DESTDIR)$(libdir)/libOSSlib.so"
+	$(LN_S) $(LIBOSSMIX_SONAME) "$(DESTDIR)$(libdir)/libossmix.so"
+
+install-progs: $(PROGS) target/bin/ossrecord
+	$(INSTALL) -d "$(DESTDIR)$(bindir)"
+	for p in $(BIN_PROGS); do \
+		$(INSTALL) -m 755 target/bin/$$p "$(DESTDIR)$(bindir)/$$p" || exit 1; \
+	done
+	for p in $(SBIN_PROGS); do \
+		$(INSTALL) -m 755 target/sbin/$$p "$(DESTDIR)$(bindir)/$$p" || exit 1; \
+	done
+	$(LN_S) ossplay "$(DESTDIR)$(bindir)/ossrecord"
+
+# Named explicitly rather than globbed, so that a tree which also has ossxmix
+# built in it does not leak that page into this package.
+install-man: man
+	$(INSTALL) -d "$(DESTDIR)$(mandir)/man1" "$(DESTDIR)$(mandir)/man7" "$(DESTDIR)$(mandir)/man8"
+	$(INSTALL) -m 644 $(MAN_BIN_PAGES) "$(DESTDIR)$(mandir)/man1/"
+	$(INSTALL) -m 644 $(MAN_DEV_PAGES) "$(DESTDIR)$(mandir)/man7/"
+	$(INSTALL) -m 644 $(MAN_SBIN_PAGES) "$(DESTDIR)$(mandir)/man8/"
+
+# $(OSSLIBDIR) is where savemixer and ossdevlinks keep their state, and
+# /etc/oss.conf is how every OSS tool finds it.  devices.list is what upstream
+# puts in etc/ (the driver device table, empty without drivers); it also keeps
+# the directory from being empty, which matters because xbps only creates
+# directories that contain files.
+#
+# Upstream also creates conf/ (per driver configuration written by confgen) and
+# save/ (backups made by its own tarball installer).  Neither has anything to
+# hold here: there are no drivers, and packages are managed by xbps.
+install-etc: version.dat
+	$(INSTALL) -d "$(DESTDIR)$(sysconfdir)"
+	echo "OSSLIBDIR=$(OSSLIBDIR)" > "$(DESTDIR)$(sysconfdir)/oss.conf"
+	chmod 644 "$(DESTDIR)$(sysconfdir)/oss.conf"
+	$(INSTALL) -d "$(DESTDIR)$(OSSLIBDIR)/etc"
+	$(INSTALL) -m 644 version.dat "$(DESTDIR)$(OSSLIBDIR)/version.dat"
+	: > "$(DESTDIR)$(OSSLIBDIR)/etc/devices.list"
+	chmod 644 "$(DESTDIR)$(OSSLIBDIR)/etc/devices.list"
+
+clean:
+	rm -rf target version.dat
+	rm -f $(GENINC)/local_config.h $(GENINC)/buildid.h $(GENINC)/timestamp.h \
+	      $(GENINC)/oss_errno.h $(GENINC)/ossddk/oss_limits.h $(GENINC)/os.h
diff --git oss-clean/cmd/ossxmix/gtkvu.c oss-workdir/cmd/ossxmix/gtkvu.c
