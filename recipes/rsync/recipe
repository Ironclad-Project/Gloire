#! /bin/sh

version=3.5.2
revision=1
tarball_url="https://www.samba.org/ftp/rsync/src/rsync-${version}.tar.gz"
tarball_blake2b="f869e19d12d2960e670e07558e3e7126728729b3765ba66f645f4434df03af2fca832fb8061055dfc6f5e6d8113fe3296610f218eef620b7a6ac924ff8ba8c4d"
hostdeps="gcc pkg-config"
deps="core-libs lz4 openssl popt xxhash zlib zstd libidn2"

prepare() {
    autotools_recursive_regen
}

configure() {
    autotools_configure \
        --with-included-zlib=no \
        --with-included-popt=no \
        --with-rrsync \
        --enable-ipv6
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    post_package_strip
}
