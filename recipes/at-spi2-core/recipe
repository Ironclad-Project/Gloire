#! /bin/sh

version=2.60.6
revision=2
tarball_url="https://gitlab.gnome.org/GNOME/at-spi2-core/-/archive/${version}/at-spi2-core-${version}.tar.gz"
tarball_blake2b="d0a1dfbb4c8363d462e3c9105f3212b6587fdbb98fd47f8787f726f34ea5d93fcc13e79f34b2b1e88a3bfcc6a646945df49e9658c60da2576da0c97cd84d3fc3"
imagedeps="libglib2.0-dev"
hostdeps="gcc pkg-config"
deps="core-libs bash dbus glib2 gsettings-desktop-schemas libx11 libxi libxkbcommon libxml2 libxtst"

configure() {
    meson_configure \
        -Dsystemd_user_dir=/remove_later \
        -Dintrospection=disabled
}

build() {
    meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    rm -rv "${dest_dir}"/remove_later

    post_package_strip
}
