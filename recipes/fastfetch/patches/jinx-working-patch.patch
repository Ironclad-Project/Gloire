diff --git fastfetch-workdir/src/detection/cpu/cpu_ironclad.c fastfetch-workdir/src/detection/cpu/cpu_ironclad.c
new file mode 100644
index 0000000..7ad301a
--- /dev/null
+++ fastfetch-workdir/src/detection/cpu/cpu_ironclad.c
@@ -0,0 +1,39 @@
+#include <sys/syscall.h>
+#include <unistd.h>
+#include "cpu.h"
+
+struct cpuinfo {
+    uint64_t conf_cores;
+    uint64_t onln_cores;
+    char model_name[64];
+    char vendor_name[64];
+    uint32_t base_mhz;
+    uint32_t max_mhz;
+    uint32_t ref_mhz;
+};
+
+const char* ffDetectCPUImpl(const FFCPUOptions* options, FFCPUResult* cpu_result) {
+	(void)options;  /* unused */
+	struct cpuinfo cpu;
+	syscall(SYS_getcpuinfo, &cpu);
+
+#if __i386__ || __x86_64__
+	ffCPUDetectByCpuid(cpu_result);
+#else
+	double base_frequency = ((double)cpu.base_mhz) / 1000;
+    double max_frequency = ((double)cpu.max_mhz) / 1000;
+	cpu_result->frequencyBase = base_frequency;
+    cpu_result->frequencyMax = max_frequency;
+#endif
+
+	ffStrbufAppendNS(&cpu_result->name, (uint32_t)strlen(cpu.model_name), cpu.model_name);
+	ffStrbufAppendNS(&cpu_result->vendor, (uint32_t)strlen(cpu.vendor_name), cpu.vendor_name);
+	cpu_result->coresOnline = (uint16_t)cpu.onln_cores;
+	// TODO: Differentiate between logical and physical
+	cpu_result->coresLogical = (uint16_t)cpu.conf_cores;
+	cpu_result->coresPhysical = (uint16_t)cpu.conf_cores;
+	// TODO: Add support for microarchitecture, packages and temperature
+	cpu_result->temperature = FF_CPU_TEMP_UNSET;
+
+	return NULL;
+}
diff --git fastfetch-workdir/src/detection/disk/disk_ironclad.c fastfetch-workdir/src/detection/disk/disk_ironclad.c
new file mode 100644
index 0000000..06f17eb
--- /dev/null
+++ fastfetch-workdir/src/detection/disk/disk_ironclad.c
@@ -0,0 +1,111 @@
+
+#include "disk.h"
+#include "common/mallocHelper.h"
+#include "common/strutil.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mount.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+// Matches Ironclad's Mount_Info (source/userland/userland-syscall.ads). Copied from
+// util-ironclad's src/lsblk.c, which drives the same syscall, rather than re-derived.
+struct ironclad_mountinfo {
+    uint32_t type;
+    uint32_t flags;
+    char     source[20];
+    uint32_t source_length;
+    char     location[20];
+    uint32_t location_length;
+    uint64_t blocksize;
+    uint64_t fragsize;
+    uint64_t sizeinfrags;
+    uint64_t freeblocks;
+    uint64_t freeblocksu;
+    uint64_t inodecount;
+    uint64_t freeinodes;
+    uint64_t freebinodesu;
+    uint64_t maxfile;
+};
+
+static const char* fsName(uint32_t type) {
+    switch (type) {
+        case MNT_EXT:    return "ext";
+        case MNT_FAT:    return "fat";
+        case MNT_DEV:    return "devfs";
+        case MNT_UNPACK: return "unpack";
+        default:         return "unknown";
+    }
+}
+
+const char* ffDetectDisksImpl(FFDiskOptions* options, FFlist* disks) {
+    uint64_t n = 16;
+    FF_AUTO_FREE struct ironclad_mountinfo* buf =
+        malloc(n * sizeof(struct ironclad_mountinfo));
+    if (buf == NULL)
+        return "malloc() failed";
+
+    long ret = syscall(SYS_listmounts, buf, n);
+    if (ret < 0)
+        return "syscall(SYS_listmounts) failed";
+
+    if ((uint64_t) ret > n) {
+        // The kernel reports the real count; grow and ask again.
+        n = (uint64_t) ret;
+        struct ironclad_mountinfo* grown =
+            realloc(buf, n * sizeof(struct ironclad_mountinfo));
+        if (grown == NULL)
+            return "realloc() failed";
+        buf = grown;
+        ret = syscall(SYS_listmounts, buf, n);
+        if (ret < 0)
+            return "syscall(SYS_listmounts) failed";
+        if ((uint64_t) ret > n)
+            ret = (long) n;
+    }
+
+    for (long i = 0; i < ret; ++i) {
+        // The two names are length-counted and NOT terminated.
+        char mountpoint[sizeof(buf[i].location) + 1];
+        char mountFrom[sizeof(buf[i].source) + 1];
+        uint32_t llen = buf[i].location_length, slen = buf[i].source_length;
+
+        if (llen > sizeof(buf[i].location)) llen = sizeof(buf[i].location);
+        if (slen > sizeof(buf[i].source))   slen = sizeof(buf[i].source);
+        memcpy(mountpoint, buf[i].location, llen); mountpoint[llen] = '\0';
+        memcpy(mountFrom,  buf[i].source,   slen); mountFrom[slen]  = '\0';
+
+        if (__builtin_expect(options->folders.length > 0, 0)) {
+            if (!ffStrbufSeparatedContainS(&options->folders, mountpoint, FF_DISK_FOLDER_SEPARATOR))
+                continue;
+        }
+
+        FFDisk* disk = FF_LIST_ADD(FFDisk, *disks);
+
+        // sizeinfrags counts FRAGMENTS, so every figure scales by fragsize.
+        disk->bytesTotal     = buf[i].sizeinfrags * buf[i].fragsize;
+        disk->bytesFree      = buf[i].freeblocks * buf[i].fragsize;
+        disk->bytesAvailable = buf[i].freeblocksu * buf[i].fragsize;
+        disk->bytesUsed      = 0; // filled in by ./disk.c
+
+        disk->filesTotal = (uint32_t) buf[i].inodecount;
+        disk->filesUsed  = (uint32_t) (buf[i].inodecount - buf[i].freeinodes);
+
+        ffStrbufInitS(&disk->mountFrom, mountFrom);
+        ffStrbufInitS(&disk->mountpoint, mountpoint);
+        ffStrbufInitS(&disk->filesystem, fsName(buf[i].type));
+        ffStrbufInit(&disk->name);
+
+        disk->type = ffStrEquals(mountpoint, "/")
+                     ? FF_DISK_VOLUME_TYPE_REGULAR_BIT
+                     : FF_DISK_VOLUME_TYPE_EXTERNAL_BIT;
+        if (buf[i].flags & MS_RDONLY)
+            disk->type |= FF_DISK_VOLUME_TYPE_READONLY_BIT;
+
+        // Ironclad reports no per-filesystem creation time.
+        disk->createTime = 0;
+    }
+
+    return NULL;
+}
diff --git fastfetch-workdir/src/detection/memory/memory_ironclad.c fastfetch-workdir/src/detection/memory/memory_ironclad.c
new file mode 100644
index 0000000..23fd66a
--- /dev/null
+++ fastfetch-workdir/src/detection/memory/memory_ironclad.c
@@ -0,0 +1,10 @@
+#include "memory.h"
+#include <unistd.h>
+
+const char* ffDetectMemory(FFMemoryResult* ram) {
+    uint64_t pageSize = instance.state.platform.sysinfo.pageSize;
+
+    ram->bytesTotal = (uint64_t) sysconf(_SC_PHYS_PAGES) * pageSize;
+    ram->bytesUsed = ram->bytesTotal - (uint64_t) sysconf(_SC_AVPHYS_PAGES) * pageSize;
+    return NULL;
+}
