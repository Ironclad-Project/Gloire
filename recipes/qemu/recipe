#! /bin/sh

version=11.1.3
revision=2
tarball_url="https://download.qemu.org/qemu-${version}.tar.xz"
tarball_blake2b="01daa99edd251f76c8da7cfd95889e48b87ffbe271006fcbabf662dc6a0d1653777f7b8a5accf46105af5af60f287dde23a01ff9c15f0b153f5a737832a20819"
imagedeps="build-essential python3-venv python3-qemu-qmp python3-wheel python3-pip libglib2.0-dev python3-sphinx python3-sphinx-rtd-theme"
hostdeps="gcc pkg-config"
deps="core-libs libnvmm sdl2-compat gtk3 glib2 ncurses pixman libjpeg-turbo libpng zlib bzip2 zstd vte cairo gdk-pixbuf libx11 libxkbcommon gnutls libtasn1 curl"

early_prepare() {
    meson subprojects download
}

configure() {
    cp -rp "${source_dir}"/* ./

    NVMM_FLAG=""
    case "${JINX_ARCH}" in
        x86_64)
            NVMM_FLAG="--enable-nvmm"
            ;;
    esac

        CFLAGS="${TARGET_CFLAGS}" \
        LDFLAGS="${TARGET_LDFLAGS}" \
    ./configure \
        -Db_colorout=always \
        -Ddtc:werror=false \
        --enable-docs \
        --cross-prefix=${OS_TRIPLET}- \
        --host=${OS_TRIPLET} \
        --prefix=${prefix} \
        --with-coroutine=sigaltstack \
        --enable-slirp \
        --disable-tpm \
        $NVMM_FLAG
}

build() {
    cd build

    meson compile --verbose -j${parallelism}
}

package() {
    cd build

    DESTDIR="${dest_dir}" meson install --no-rebuild

    rm -f "${dest_dir}${prefix}"/share/man/man8/qemu-pr-helper.8

    post_package_strip
}
