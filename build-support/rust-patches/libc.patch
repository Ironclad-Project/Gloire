+pub type wchar_t = c_int;
+pub type __fd_mask = c_long;
+
+// `typedef struct __dirstream DIR;` -- opaque by construction.
+pub enum DIR {}
+
+// glibc's own internal names for types above, plus the C99 stdint helpers. Each
+// width is MEASURED from our headers, not carried over: __rlimit_resource_t is a
+// plain int here where hurd's glibc makes it a tagged enum, and __clockid_t is
+// eight bytes where Linux has four.
+pub type __clockid_t = c_long;
+pub type __intptr_t = c_long;
+pub type __off_t = c_long;
+pub type __rlimit_resource_t = c_int;
+pub type __sig_atomic_t = c_int;
+pub type int_fast8_t = c_schar;
+pub type int_fast16_t = c_long;
+pub type int_fast32_t = c_long;
+pub type int_least8_t = c_schar;
+pub type int_least16_t = c_short;
+pub type int_least32_t = c_int;
+pub type uint_fast8_t = c_uchar;
+pub type uint_fast16_t = c_ulong;
+pub type uint_fast32_t = c_ulong;
+pub type uint_least8_t = c_uchar;
+pub type uint_least16_t = c_ushort;
+pub type uint_least32_t = c_uint;
+
+// The LFS64 aliases. Our bits/typesizes.h sets __OFF_T_MATCHES_OFF64_T, and the
+// measurement agrees: off64_t is 8 bytes signed, exactly off_t. `struct stat64`
+// _Generic-matches `struct stat`, so it really is the same type -- while
+// `struct dirent64` does NOT, despite both being 280 bytes, so it is declared
+// separately below rather than aliased. Same size is not the same type.
+pub type off64_t = off_t;
+pub type ino64_t = ino_t;
+pub type blkcnt64_t = blkcnt_t;
+pub type fsblkcnt64_t = fsblkcnt_t;
+pub type fsfilcnt64_t = fsfilcnt_t;
+pub type stat64 = stat;
+
+
+// opaque types, sized and aligned as our glibc defines them
+s_no_extra_traits! {
+    pub struct pthread_attr_t {
+        size: [u8; 56],
+        align: [u64; 0],
+    }
+
+    pub struct pthread_cond_t {
+        size: [u8; 48],
+        align: [u64; 0],
+    }
+
+    pub struct pthread_condattr_t {
+        size: [u8; 4],
+        align: [u32; 0],
+    }
+
+    pub struct pthread_mutex_t {
+        size: [u8; 40],
+        align: [u64; 0],
+    }
+
+    pub struct pthread_mutexattr_t {
+        size: [u8; 4],
+        align: [u32; 0],
+    }
+
+    pub struct pthread_rwlock_t {
+        size: [u8; 56],
+        align: [u64; 0],
+    }
+
+    pub struct pthread_rwlockattr_t {
+        size: [u8; 8],
+        align: [u64; 0],
+    }
+
+    pub struct sem_t {
+        size: [u8; 32],
+        align: [u64; 0],
+    }
+
+    pub struct siginfo_t {
+        size: [u8; 128],
+        align: [u64; 0],
+    }
+
+    pub struct sigset_t {
+        size: [u8; 128],
+        align: [u64; 0],
+    }
+}
