diff --git opus-clean/doc/Doxyfile.in opus-workdir/doc/Doxyfile.in
index 6eef650..f9e3272 100644
--- opus-clean/doc/Doxyfile.in
+++ opus-workdir/doc/Doxyfile.in
@@ -54,6 +54,14 @@ PROJECT_LOGO           =
 
 FULL_PATH_NAMES        = NO
 
+# STRIP_FROM_PATH is required even with FULL_PATH_NAMES = NO: doxygen's default
+# strip path is the directory it is RUN from, which for an out-of-tree build is
+# the build directory and shares no prefix with the sources. Without it doxygen
+# publishes a directory page per level of the absolute input path and writes the
+# whole chain into every breadcrumb.
+
+STRIP_FROM_PATH        = @top_srcdir@ @top_builddir@
+
