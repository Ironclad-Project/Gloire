+# font-view.c, font-thumbnailer.c and the sushi-font-* sources call the FreeType API
+# directly (FT_Get_Sfnt_Name, FT_Get_First_Char, FT_Done_Face, ...), but this meson
+# build never asks for freetype2. Upstream's own AUTOTOOLS build does, at
+# configure.ac:196 -- PKG_CHECK_MODULES(FONT_VIEWER, $COMMON_MODULES fontconfig
+# freetype2 mate-desktop-2.0) -- so the omission is in the meson port alone. pango.pc
+# keeps freetype2 in Requires.private, so nothing else puts libfreetype on the link
+# line and ld refuses outright: "undefined reference to symbol 'FT_Get_Sfnt_Name' /
+# libfreetype.so.6: error adding symbols: DSO missing from command line".
+freetype_dep = dependency('freetype2')
 deps = [
   common_deps,
   pango_dep,
   fontconfig_dep,
+  freetype_dep,
   libm,
 ]
