+
+void
+_glibtop_init_proclist_s (glibtop *server)
+{
+	server->sysdeps.proclist = _glibtop_sysdeps_proclist;
+}
+
+/* SYS_listprocs reports how many processes exist even when the buffer was
+   too small, so grow and repeat.  This is util-ironclad ps.c's idiom, and
+   it is shared here because every proc* sysdep below needs the same table.  */
+struct ironclad_procinfo *
+_glibtop_ironclad_proclist (unsigned long *count)
+{
+	struct ironclad_procinfo *buf;
+	long ret;
+	unsigned long n = 64;
+
+	*count = 0;
+
+	buf = malloc (n * sizeof (struct ironclad_procinfo));
+	if (buf == NULL)
+		return NULL;
+
+	ret = syscall (SYS_listprocs, buf, n);
+	if (ret < 0) {
+		free (buf);
+		return NULL;
+	}
+
+	if ((unsigned long) ret > n) {
+		struct ironclad_procinfo *grown;
+
+		n = (unsigned long) ret;
+		grown = realloc (buf, n * sizeof (struct ironclad_procinfo));
+		if (grown == NULL) {
+			free (buf);
+			return NULL;
+		}
+		buf = grown;
+
+		ret = syscall (SYS_listprocs, buf, n);
+		if (ret < 0) {
+			free (buf);
+			return NULL;
+		}
+		if ((unsigned long) ret > n)
+			ret = (long) n;
+	}
+
+	*count = (unsigned long) ret;
+	return buf;
+}
+
+/* On error this MUST return NULL and leave buf->flags zero.  */
+pid_t *
+glibtop_get_proclist_s (glibtop *server, glibtop_proclist *buf,
+			gint64 which, gint64 arg)
+{
+	struct ironclad_procinfo *procs;
+	unsigned long count, i, n = 0;
+	pid_t *pids;
+
+	memset (buf, 0, sizeof (glibtop_proclist));
+
+	procs = _glibtop_ironclad_proclist (&count);
+	if (procs == NULL)
+		return NULL;
+
+	pids = g_new0 (pid_t, count ? count : 1);
+
+	for (i = 0; i < count; i++) {
+		switch (which & GLIBTOP_KERN_PROC_MASK) {
+		case GLIBTOP_KERN_PROC_PID:
+			if (procs [i].pid != (uint16_t) arg) continue;
+			break;
+		case GLIBTOP_KERN_PROC_UID:
+		case GLIBTOP_KERN_PROC_RUID:
+			if (procs [i].uid != (uint32_t) arg) continue;
+			break;
+		case GLIBTOP_KERN_PROC_ALL:
+			break;
+		default:
+			/* PGRP, SESSION and TTY have no Ironclad interface.
+			   Refuse rather than silently answering the wrong
+			   question with the full table.  */
+			g_free (pids);
+			free (procs);
+			return NULL;
+		}
+
+		pids [n++] = (pid_t) procs [i].pid;
+	}
+
+	free (procs);
+
+	buf->number = n;
+	buf->size   = sizeof (pid_t);
+	buf->total  = n * sizeof (pid_t);
+	buf->flags  = _glibtop_sysdeps_proclist;
+
+	return pids;
+}
