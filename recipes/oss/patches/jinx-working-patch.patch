+ * gtk_type_unique, GtkObject::destroy) and the GdkGC/GdkPixmap drawing this
+ * widget used are both gone in GTK3, so the type is now a normal GObject and
+ * drawing happens in the ::draw handler with cairo.  GTK3 double buffers that
+ * for us, so the offscreen pixmap the original kept is no longer needed, and
+ * neither is the widget's own GdkWindow - the meter draws nothing outside its
+ * allocation, so it can be a windowless widget.
+ */
 
-#include <stdio.h>
-#include <gtk/gtkmain.h>
-#include <gtk/gtksignal.h>
+#include <gtk/gtk.h>
 
 #include "gtkvu.h"
 
 extern int width_adjust;
 
-#define SCROLL_DELAY_LENGTH  300
-#define VU_DEFAULT_SIZE 100
-#define VU_MARGIN	(widget->allocation.width/3)
+#define VU_DEFAULT_WIDTH	20
+#define VU_WIDE_WIDTH		28
+#define VU_DEFAULT_HEIGHT	85
+#define VU_SEGMENTS		8
 
-/* Forward declarations */
-
