#! /bin/sh

version=14.4.0
revision=1
tarball_url="https://github.com/harfbuzz/harfbuzz/releases/download/${version}/harfbuzz-${version}.tar.xz"
tarball_blake2b="bca47aa5bc12e865529c031d34559978bc4d098f9e09a586e21c6631535a49f7b6c0c217bb03952e141df3a083465d2a811c27a9d136d0ae23e150d9a75ae9bb"
imagedeps="libglib2.0-dev-bin"
hostdeps="gcc pkg-config"
deps="core-libs graphite2 glib2 zlib freetype2 libpng cairo icu"

configure() {
    meson_configure \
        -Dchafa=disabled \
        -Dgpu_demo=disabled \
        -Ddocs=disabled \
        -Dgraphite2=enabled \
        -Dintrospection=disabled \
        -Dtests=disabled
}

build() {
    meson compile --verbose -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
