#! /bin/sh

name=ironclad
skip_pkg_check=yes
version=0.0git
revision=57
git_url="https://codeberg.org/Ironclad/Ironclad.git"
commit=fc9f237da6a9ed05c43dc21a59d6c1a2f8eef360
source_hostdeps="autoconf automake pkg-config"
imagedeps="gprbuild"
hostdeps="gcc pkg-config"
deps="core-libs"

early_prepare() {
    ./bootstrap
}

prepare() {
    autotools_recursive_regen
}

configure() {
    autotools_configure_noflags
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install
}
