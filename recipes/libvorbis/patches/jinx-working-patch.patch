diff --git libvorbis-clean/CMakeLists.txt libvorbis-workdir/CMakeLists.txt
index f377c42..6c3391a 100644
--- libvorbis-clean/CMakeLists.txt
+++ libvorbis-workdir/CMakeLists.txt
@@ -42,6 +42,11 @@ function(get_version_info result current_var_name age_var_name revision_var_name
     math(EXPR VERSION_INFO_CURRENT_MINUS_AGE "${VERSION_INFO_CURRENT} - ${VERSION_INFO_AGE}")
 
     set(${result} "${VERSION_INFO_CURRENT_MINUS_AGE}.${VERSION_INFO_AGE}.${VERSION_INFO_REVISION}" PARENT_SCOPE)
+    # libtool's -version-info puts (current - age) in the soname, and the full
+    # triplet only in the file name.  Export it so callers can set SOVERSION
+    # and VERSION separately, which is what produces the lib.so.<major>
+    # symlink every consumer links against.
+    set(${result}_SOVERSION "${VERSION_INFO_CURRENT_MINUS_AGE}" PARENT_SCOPE)
 endfunction()
 
 # Helper function to configure pkg-config files
